# Local development stack (docker-compose.yml). Copy to .env next to this file; production uses deploy/env.prod.example instead.

# Password of the local development database. Keeping this default is safe only while the database runs on your own machine for development and holds no real data; anything reachable from other machines or holding real exams needs a random value (openssl rand -hex 24).
# Set it before the first `make dev-up`: Postgres applies it only when the pg_data volume is created (otherwise `docker compose down -v` first), and put the same value into DATABASE_URL(_SYNC) in backend/.env.
POSTGRES_PASSWORD=blindgrade

# Required by the backend container; generate with: openssl rand -hex 32
SECRET_KEY=
