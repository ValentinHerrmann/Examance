\DeclareOption{papierkaro}{\def\SA@paper{karo}}
\DeclareOption{papierlinien}{\def\SA@paper{linien}}
% zusatzblatt: the exam-independent extra sheet (\Zusatzblatt), no cover and no exam title.
\newboolean{SA@zusatzblatt}
\DeclareOption{zusatzblatt}{\setboolean{SA@zusatzblatt}{true}}

