% Initialize global total score variable
\gdef\TotalScoreG{0}

% Helper to safely format xfp float outputs (e.g., 1.25 -> 1,25)
\newcommand{\formatScore}[1]{%
    \expandafter\@formatScore\fpeval{#1}..\@nil
}
\def\@formatScore#1.#2.#3\@nil{%
    \ifx\relax#2\relax
        #1% No decimal present
    \else
        #1,#2% Replaces dot with comma
    \fi
}

% BE Commands: \xdef globally accumulates the score into \TaskScore and, inside a
% Teilaufgabe, into \PartScore as well (\PartScore is reset by every Teilaufgabe).
\gdef\PartScore{0}
% amsmath (align...) and tabularx typeset their body again just to measure it (issue #141); only the
% final pass may count, or a BE inside them is added two or three times.
\newcommand{\@addBE}[1]{%
    \ifmeasuring@\else\ifx\@footnotetext\TX@trial@ftn\else%
        \ifcsname TaskScore\endcsname\else\gdef\TaskScore{0}\fi%
        \xdef\TaskScore{\fpeval{\TaskScore + #1}}%
        \xdef\PartScore{\fpeval{\PartScore + #1}}%
    \fi\fi%
}
\newcommand{\BE}{%
    \@addBE{1}%
    \ifthenelse{
        \boolean{Antworten}
    }{
        \textcolor{\LFarbe}{\fullcheckmark}
    }{}%
}
\newcommand{\hBE}{%
    \@addBE{0.5}%
    \ifthenelse{
        \boolean{Antworten}
    }{
        \textcolor{\LFarbe}{\halfcheckmark}
    }{}%
}
\newcommand{\qBE}{%
    \@addBE{0.25}%
    \ifthenelse{
        \boolean{Antworten}
    }{
        \textcolor{\LFarbe}{\quartcheckmark}
    }{}%
}

% Fixed score instead of the counted BE (issue #79): applies to the enclosing Teilaufgabe,
% else to the whole Aufgabe. Same effect as the optional argument of either environment.
\newif\if@inTeilaufgabe
\gdef\TaskFixedScore{}
\gdef\PartFixedScore{}
\newcommand{\FestePunkte}[1]{%
    \@bsphack%
    \if@inTeilaufgabe\gdef\PartFixedScore{#1}\else\gdef\TaskFixedScore{#1}\fi%
    \@esphack%
}

% Exercise metadata (issue #78): Anforderungsbereich and competencies. Invisible on the
% student sheet, a small tag in the Erwartungshorizont. The editor reads them from the source.
\newcommand{\MetaTag}[1]{{\footnotesize\textcolor{\LFarbe}{[#1]}}}
\newcommand{\AFB}[1]{%
    \ifthenelse{\boolean{Antworten}}{\MetaTag{AFB~#1}}{\@bsphack\@esphack}%
}
\newcommand{\Kompetenz}[1]{%
    \ifthenelse{\boolean{Antworten}}{\MetaTag{#1}}{\@bsphack\@esphack}%
}

% Safely fetches the score of a given exercise number (1, 2, 3...)
\newcommand{\getScore}[1]{%
    \ifcsname AufgabeScore#1\endcsname
        \csname AufgabeScore#1\endcsname%
    \else
        -% Fallback during first compile
    \fi
}

