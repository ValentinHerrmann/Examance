% ==============================================================================
% 6. Name Box (Namenszeile) & Header Setup
% ==============================================================================

\newcommand{\Namenszeile}{
    \LARGE\begin{center}
    \ifthenelse
    {\boolean{Antworten}}
    {\color{\LFarbe}Erwartungshorizont \\ \normalsize Korrektur-Symbole: \fullcheckmark 1BE, \halfcheckmark 0,5BE, \quartcheckmark 0,25BE; \Large \sout{V} \normalsize fehlt; \Large f \normalsize falsch; \large FF/WF \normalsize kein Abzug, da Folge-/Wiederholungsfehler \color{black}}
    {
        \setlength\unitlength{1cm}
        \centering
        \begin{minipage}[t]{3.5cm}
        \vspace{0pt} % Setzt die Grundlinie an die physische Oberkante
        \textcolor{gray}{
            \dashbox{0.2}(3.5,3.5){
                \parbox{3.5cm}{
                    \centering QR Code
                    \ifthenelse{\boolean{Namensfeld}}{}{\\
                    \normalsize \vspace{0.8cm}\LoesungLuecke{}{2.5cm}\\$\uparrow$~Deine Initialen~$\uparrow$\\
                    (falls QR-Code abfällt)}
                }
            }
        }
        \end{minipage}% <-- Ein % hier verhindert einen ungewollten Zeilenumbruch/Abstand
        \begin{minipage}[t]{15cm}
        \vspace{5pt} % Setzt die Grundlinie an die physische Oberkante
        \normalsize
        % Name starts where the info bullets do; the strut is the room to write above the line.
        \ifthenelse{\boolean{Namensfeld}}{\settowidth{\@tempdima}{\textbullet}\noindent\hspace*{\dimexpr\leftmargini-\labelsep-\@tempdima\relax}%
            \rule{0pt}{1cm}{\large Name:}~\leaders\hrule height 0.5pt\hfill\null\par}{}%
        \Infotext
        % Offsets the -0.7cm below, so a long info text pushes the rule down instead of crossing it.
        \ifthenelse{\boolean{Namensfeld}}{\par\vspace{0.7cm}}{}%
        \end{minipage}
    }
    \normalsize

    \vspace{-0.7cm}
    \textcolor{lightgray}{\noindent\rule{\textwidth}{0.5pt}}
    \end{center}
}

% Exam logo (top left of page 1). The compile writes the teacher's logo next to
% main.tex as examance-logo.<pdf|png|jpg|jpeg> (backend app/services/logo.py,
% frontend lib/latex/logo.ts); without one the header simply has no logo. The
% box is always 9mm tall, so the page layout (and the OMR template) is the
% same with and without a logo.
\newcommand{\ExamLogoFile}[1]{%
    \includegraphics[height=9mm,width=6cm,keepaspectratio]{#1}}
\newcommand{\ExamLogo}{%
    \IfFileExists{examance-logo.pdf}{\ExamLogoFile{examance-logo.pdf}}{%
    \IfFileExists{examance-logo.png}{\ExamLogoFile{examance-logo.png}}{%
    \IfFileExists{examance-logo.jpg}{\ExamLogoFile{examance-logo.jpg}}{%
    \IfFileExists{examance-logo.jpeg}{\ExamLogoFile{examance-logo.jpeg}}{%
    \rule{0pt}{9mm}}}}}}

% The output routine typesets the header inside whatever group the page broke in, so a task's local
% settings (e.g. \arraystretch) used to stretch the header (issue #137). Every header cell resets them.
\newcommand{\SA@headreset}{%
    \normalfont\normalsize\normalcolor
    \renewcommand{\arraystretch}{1}\setlength{\extrarowheight}{0pt}\setlength{\tabcolsep}{6pt}%
}

% Setup headers and footers at document start
\AtBeginDocument{
    \fancyheadoffset[L]{5mm}
    \fancyheadoffset[R]{5mm}
    \lhead{\SA@headreset\ifnum\thepage=1
    {\hspace{1cm}\ExamLogo}
    \else
    \hspace{1cm}\Nrtext. \Testarttesttext \ in \Fachtext%Name:
    \fi}
    \rhead{\SA@headreset
    \ifnum\thepage=1
    {%
    \begin{tabular}[b]{@{}r@{}}
        \Datumtext \\
        Klasse \Klassetext \ (\Lehrernachnametext)
    \end{tabular}\hspace*{1cm}%
    }
    \else
    \fi
    }
    \chead{\SA@headreset
    \ifnum\thepage=1
    {
    \Large
    \Nrtext. \Testarttesttext \ in \Fachtext \normalsize
    }
    \else
    \fi
    }
    \cfoot{\SA@headreset\thepage}

    \ifthenelse
        {\isundefined{\LFarbe}}
        {\newcommand{\LFarbe}{blue}}
        {}
        \Namenszeile
}

% ==============================================================================
% 6b. OMR Fiducial Markers (every page, absolute position via eso-pic)
% ==============================================================================
% Four corner markers let the client locate a homography from a photographed
% scan back to the compiled PDF's coordinate space (see frontend omrWorker.ts).
% Unlike \Namenszeile, these must appear on EVERY page, since MC questions can
% land on any page -- \AddToShipoutPictureBG (eso-pic) re-runs per shipout.
% Each marker also carries an invisible \href link (like the OMR bubbles in
% Loesung.sty) so the same pdfjs getAnnotations() pass extracts both in one go.
% Note: fiducials sit inside the header's own vertical band (headheight/top
% margin unchanged) -- only \fancyheadoffset (packages.sty headheight stays as
% original) nudges \lhead/\rhead content 3mm inward so it clears the corners
% horizontally. Footer table placement (packages.sty bottom + tabularx inset)
% is sized so it stays outside the 13mm corner fiducial zone (5mm inset + 8mm size).
\newlength{\OmrFiducialSize}
\setlength{\OmrFiducialSize}{8mm}
\newlength{\OmrFiducialInset}
\setlength{\OmrFiducialInset}{5mm}

% Solid black square with a white/black inset -- cheap to find as the largest
% dark blob in each page-corner quadrant via flood fill.
\newcommand{\OmrFiducialShape}{%
    \begin{tikzpicture}
        \fill[black] (0,0) rectangle (\OmrFiducialSize,\OmrFiducialSize);
        \fill[white] (0.2\OmrFiducialSize,0.2\OmrFiducialSize) rectangle (0.8\OmrFiducialSize,0.8\OmrFiducialSize);
        \fill[black] (0.35\OmrFiducialSize,0.35\OmrFiducialSize) rectangle (0.65\OmrFiducialSize,0.65\OmrFiducialSize);
    \end{tikzpicture}%
}

% #1 = corner index (0=bottom-left,1=bottom-right,2=top-right,3=top-left),
% #2/#3 = offset from the page's lower-left corner, as TeX lengths (not bare
% \put numbers -- \LenToUnit converts a length to the decimal \put expects
% under the current \unitlength; \AtPageLowerLeft anchors the origin so 0,0
% is the physical lower-left corner regardless of margins, matching the
% 0=BL,1=BR,2=TR,3=TL convention omrWorker.ts assumes).
\newcommand{\OmrFiducialAt}[3]{%
    \typeout{[OMR-TRACE] OmrFiducialAt corner=#1 x=#2 y=#3}%
    \AtPageLowerLeft{\put(\LenToUnit{#2},\LenToUnit{#3}){\OmrLink{\OmrFiducialSize}{\OmrFiducialSize}{omr://__fid__/#1}\OmrFiducialShape}}%
}

\AddToShipoutPictureBG{%
    \OmrFiducialAt{0}{\OmrFiducialInset}{\OmrFiducialInset}%
    \OmrFiducialAt{1}{\dimexpr\paperwidth-\OmrFiducialInset-\OmrFiducialSize\relax}{\OmrFiducialInset}%
    \OmrFiducialAt{2}{\dimexpr\paperwidth-\OmrFiducialInset-\OmrFiducialSize\relax}{\dimexpr\paperheight-\OmrFiducialInset-\OmrFiducialSize\relax}%
    \OmrFiducialAt{3}{\OmrFiducialInset}{\dimexpr\paperheight-\OmrFiducialInset-\OmrFiducialSize\relax}%
}

% ==============================================================================
% 7. Points Table Generation at Document End
% ==============================================================================

\AtEndDocument{%
    \vfill
    \ifthenelse{\boolean{Pkt}}{%
        \Large
        \noindent
        \N=\value{Punkte}%
        \setcounter{Notenzeile}{\value{Punkte}}%
        \stepcounter{Notenzeile}%
        \cols={}%
        \scorecols={}%
        \last={}%
        \setcounter{i}{1}%
        \loop
            \edef\tempcols{\the\cols \the\value{i}}%
            \cols=\expandafter{\tempcols}%
            \edef\tempscores{\the\scorecols \noexpand\getScore{\the\value{i}}}%
            \scorecols=\expandafter{\tempscores}%
            \ifnum\value{i}<\N
                \cols=\expandafter{\the\cols &}%
                \scorecols=\expandafter{\the\scorecols &}%
                \last=\expandafter{\the\last&}%
                \stepcounter{i}%
        \repeat

        \noindent\hspace{3mm}\begin{tabularx}{\dimexpr\textwidth-6mm\relax}{|*{\N}{C|}C|C|}\hline
            \the\cols & $\sum$ & Note\\\hline
            \the\scorecols & \formatScore{\TotalScoreG} & \\\cline{1-\theNotenzeile}
            \the\last &&\\\hline
        \end{tabularx}%
        \normalsize
    }{}%
}

% ==============================================================================
% 8. Exercise Environment (Aufgabe) & Layout Settings
% ==============================================================================

\newlength{\FirstColWidth}
\setlength{\FirstColWidth}{2mm}
\newlength{\LastColWidth}
\setlength{\LastColWidth}{15mm}
\newlength{\MiddleColWidth}
\setlength{\MiddleColWidth}{\dimexpr\textwidth - \FirstColWidth - \LastColWidth - 5mm}
\newsavebox{\TaskBox}

% Page-break blocks: a task is cut at the end of each Teilaufgabe (block 1 = title, stem and a); block n = what
% follows the previous part through the next one) and at \Seitenumbruch. Each pass writes every block's height
% to the .aux; the next pass moves a block that fits on a page but not in the space left (\needspace).
\newif\ifSA@inblock
\newcount\SA@blockno
\newdimen\SA@h
\def\SA@blockid{\thePunkte-\the\SA@blockno}
\def\SA@bs#1#2#3{\expandafter\gdef\csname SA@bs@#1\endcsname{{#2}{#3}}}
\def\SA@be#1#2#3{\expandafter\gdef\csname SA@be@#1\endcsname{{#2}{#3}}}
% Deferred write: page and position are those of the shipped page.
\def\SA@savepos#1{%
    \pdfsavepos
    \edef\SA@tmp{\write\@auxout{\string\SA@#1{\SA@blockid}{\noexpand\the\c@page}{\noexpand\the\pdflastypos}}}%
    \SA@tmp
}
% \SA@h := height of block #1 from the previous pass (start page/y, end page/y in sp), -1sp if unknown.
\def\SA@height#1{%
    \SA@h=-1sp
    \ifcsname SA@bs@#1\endcsname\ifcsname SA@be@#1\endcsname
        \expandafter\expandafter\expandafter\SA@height@a\csname SA@bs@#1\endcsname{#1}%
    \fi\fi
}
\def\SA@height@a#1#2#3{\expandafter\expandafter\expandafter\SA@height@b\csname SA@be@#3\endcsname{#1}{#2}}
\def\SA@height@b#1#2#3#4{% end page, end y, start page, start y
    \ifnum#1=#3\relax
        \SA@h=\dimexpr#4sp-#2sp\relax
    \else
        \SA@h=\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax % top of the text area
        \SA@h=\dimexpr#4sp-(\SA@h-\textheight) + \textheight*(#1-#3-1) + \SA@h-#2sp\relax
    \fi
    \SA@h=\numexpr\SA@h/65536*65536\relax sp% whole pt, so passes settle
}
% #1 = space to keep in any case (the title's 3cm; a block taller than a page keeps only this).
\def\SA@blockbegin#1{%
    \par
    \global\advance\SA@blockno\@ne
    \SA@height{\SA@blockid}%
    \ifdim\SA@h<\textheight\else\SA@h=-1sp\fi
    \ifdim\SA@h<#1\SA@h=#1\fi
    \ifdim\SA@h>\z@ \needspace{\SA@h}\fi
    \global\SA@inblocktrue
    \SA@savepos{bs}%
}
\def\SA@blockend{\par\ifSA@inblock \SA@savepos{be}\global\SA@inblockfalse\fi}
% Teacher override: a page break exactly here; the blocks on both sides keep their rules.
\newcommand{\Seitenumbruch}{\par\ifSA@inblock\SA@blockend\newpage\SA@blockbegin\z@\else\newpage\fi}

% A picture never ends a page: it stays with the text after it.
\def\SA@keepwithnext{\ifvmode\else\ifinner\else\vadjust{\penalty\@M}\fi\fi}
\AtBeginDocument{%
    \NewCommandCopy\SA@includegraphics\includegraphics
    \RenewDocumentCommand\includegraphics{s o o m}{%
        \IfBooleanTF{#1}%
            {\IfNoValueTF{#2}{\SA@includegraphics*{#4}}{\IfNoValueTF{#3}{\SA@includegraphics*[#2]{#4}}{\SA@includegraphics*[#2][#3]{#4}}}}%
            {\IfNoValueTF{#2}{\SA@includegraphics{#4}}{\IfNoValueTF{#3}{\SA@includegraphics[#2]{#4}}{\SA@includegraphics[#2][#3]{#4}}}}%
        \SA@keepwithnext
    }%
}

% The score box sits at the right end of the title line like the Teilaufgabe box; \hangindent keeps the title line
% clear of it. Never a wrapfigure: it left \linewidth 3cm short for the whole first paragraph (issue #140) and
% wrapped the title line differently per document (issue #138); nor a band above the title, which wasted a line.
% Page breaks follow the blocks above; without a measured height the title keeps 3cm of its task (issue #113).
\newenvironment{Aufgabe}[2][]
{%
\par
% Fixed size for \quad and \hangindent: they used to follow the \LARGE that \Namenszeile leaks into exams, so the
% exercise preview (no \Namenszeile) wrapped differently (issue #111).
\LARGE
\addvspace{\dimexpr 1ex + \topskip\relax}%
\stepcounter{Punkte}%
\global\SA@blockno\z@
\SA@blockbegin{3cm}%
% An invisible rule survives a page top, so the box stays 4pt below the header rule there (issue #106); the kern
% takes back the \topskip that TeX puts before the rule at a page top, and \addvspace the same amount mid-page.
\hrule\@height\z@\nobreak\kern\dimexpr 4pt - \topskip\relax
    \neverindent
    \gdef\TaskScore{0}% Reset task score accumulator for the new exercise
    \gdef\TaskFixedScore{}% \FestePunkte inside the body
    \def\ManualScore{#1}% Store optional override

    % Read from .aux to populate the score box
    \ifcsname AufgabeScore\thePunkte\endcsname
        \edef\Pkt{\csname AufgabeScore\thePunkte\endcsname}%
        \def\PrintPkt{\formatScore{\Pkt}}%
    \else
        \def\Pkt{0}% Fallback for internal arrays
        \def\PrintPkt{-}% UI Fallback for the very first compilation
    \fi
    % \aPunkte mapping removed (unused)
    % Title line with the score box (no \par between the shape and the title, or TeX resets the shape)
    \sbox\TaskBox{\Large\framebox[1.1\width]{ ~~~~~ / ~\PrintPkt~}}%
    \noindent
    \hangindent=-\dimexpr\wd\TaskBox+1em\relax \hangafter=-1
    % Bottom on the baseline: hanging below it, the box ran into the second line, which \hangindent does not shorten.
    \makebox[0pt][l]{\hspace{\linewidth}\llap{\raisebox{\dp\TaskBox}{\usebox\TaskBox}}}%
    \textbf{\Large (\thePunkte) #2} \quad
    \ignorespaces \normalsize
}
{%
    \SA@blockend
    \vspace{1ex}%
    % Determine final score: auto-calculated or manual override?
    \ifx\ManualScore\empty
        \ifx\TaskFixedScore\empty
            \xdef\FinalScore{\TaskScore}%
        \else
            \xdef\FinalScore{\TaskFixedScore}%
        \fi
    \else
        \xdef\FinalScore{\ManualScore}%
    \fi

    % Write the evaluated score to the .aux file for the next run
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space AufgabeScore\thePunkte\string\endcsname{\FinalScore}}%

    % Add current score to global exam total
    \xdef\TotalScoreG{\fpeval{\TotalScoreG + \FinalScore}}%
    \normalsize
}

% ==============================================================================
% 8b. Part Exercises (Teilaufgabe, issue #77)
% ==============================================================================
% \begin{Teilaufgabe}[fixed score]{subtitle} inside an Aufgabe: labelled a), b), ..., the title run in
% like \paragraph, with its own score box. Its BE count towards the Aufgabe as usual; a fixed score replaces them.
% Like the Aufgabe box, the part box reads its score from the .aux of the previous run.
\newcounter{Teilaufgabe}[Punkte]
\renewcommand{\theTeilaufgabe}{\alph{Teilaufgabe}}

\newsavebox{\PartBox}
\newenvironment{Teilaufgabe}[2][]
{%
    \par\vspace{1ex}\noindent
    \stepcounter{Teilaufgabe}%
    \@inTeilaufgabetrue
    \gdef\PartScore{0}%
    \gdef\PartFixedScore{#1}%
    \ifcsname TeilScore\thePunkte\theTeilaufgabe\endcsname
        \def\PrintPartPkt{\formatScore{\csname TeilScore\thePunkte\theTeilaufgabe\endcsname}}%
    \else
        \def\PrintPartPkt{-}%
    \fi
    % Run-in title like \paragraph. The score box hangs at the right end of the first line,
    % which \hangindent shortens so the text never runs into it.
    \sbox\PartBox{\large\framebox[1.1\width]{~~~~ / ~\PrintPartPkt~}}%
    \hangindent=-\dimexpr\wd\PartBox+1em\relax \hangafter=-1
    \makebox[0pt][l]{\hspace{\linewidth}\llap{\usebox\PartBox}}%
    \textbf{\theTeilaufgabe)\if\relax\detokenize{#2}\relax\else~#2\fi}\quad
    \ignorespaces
}
{%
    \par
    \ifx\PartFixedScore\empty
        \xdef\FinalPartScore{\PartScore}%
    \else
        \xdef\FinalPartScore{\PartFixedScore}%
        \xdef\TaskScore{\fpeval{\TaskScore - \PartScore + \PartFixedScore}}%
    \fi
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space TeilScore\thePunkte\theTeilaufgabe\string\endcsname{\FinalPartScore}}%
    \SA@blockend\SA@blockbegin\z@
}

