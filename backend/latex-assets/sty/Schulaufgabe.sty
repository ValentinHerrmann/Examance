% The text reaches the markers' outer edges (5mm) and the header row starts at 11.9mm, so on every page the body (22.4mm) begins below the corner zone (21.8mm deep at the text edge).
\geometry{top=11.9mm,left=5mm,right=5mm}
% Booklets keep the 6mm cut strip along the fold free (section 11): text and the fold-side markers start 8mm from the fold (left on odd pages, right on even ones).
\newlength{\SA@foldinset}
\ifthenelse{\boolean{SA@broschuere}}{\geometry{twoside,inner=8mm,outer=5mm}\setlength{\SA@foldinset}{8mm}}{\setlength{\SA@foldinset}{5mm}}

% ==============================================================================
% 6. Name Box (Namenszeile) & Header Setup
% ==============================================================================

\newcommand{\Namenszeile}{
    \LARGE\begin{center}
    \ifthenelse
    {\boolean{Antworten}}
    {\color{\LFarbe}Erwartungshorizont \\ \normalsize Korrektur-Symbole: \fullcheckmark 1BE, \halfcheckmark 0,5BE, \quartcheckmark 0,25BE; \Large \sout{V} \normalsize fehlt; \Large f \normalsize falsch; \large FF/WF \normalsize kein Abzug, da Folge-/Wiederholungsfehler \color{black}}
    {
        \setlength\unitlength{1cm}
        \centering
        \begin{minipage}[t]{3.5cm}
        \vspace{0pt} % Setzt die Grundlinie an die physische Oberkante
        \textcolor{gray}{
            % Where printed student copies stamp the QR code (frontend lib/qr/examCopies.ts).
            \OmrLink{3.5cm}{3.5cm}{omr://__qr__}\dashbox{0.2}(3.5,3.5){
                \parbox{3.5cm}{
                    % Printed copies blank this text under their code; spare plain copies keep it for a sticker.
                    \centering QR Code
                    \ifthenelse{\boolean{Namensfeld}}{}{\\
                    \normalsize \vspace{0.8cm}\LoesungLuecke{}{2.5cm}\\$\uparrow$~Deine Initialen~$\uparrow$\\
                    (falls QR-Code abfällt)}
                }
            }
        }
        \end{minipage}% <-- Ein % hier verhindert einen ungewollten Zeilenumbruch/Abstand
        \hspace{5mm}%
        % Box, gap and info fill the text width exactly, so the box starts at the text edge, flush with the corner markers.
        \begin{minipage}[t]{\dimexpr\textwidth-3.5cm-5mm\relax}
        \vspace{5pt} % Setzt die Grundlinie an die physische Oberkante
        \normalsize
        % Name starts where the info bullets do; the strut is the room to write above the line.
        \ifthenelse{\boolean{Namensfeld}}{\settowidth{\@tempdima}{\textbullet}\noindent\hspace*{\dimexpr\leftmargini-\labelsep-\@tempdima\relax}%
            \rule{0pt}{1cm}{\large Name:}~\leaders\hrule height 0.5pt\hfill\null\par}{}%
        \Infotext
        % Offsets the -0.7cm below, so a long info text pushes the rule down instead of crossing it.
        \ifthenelse{\boolean{Namensfeld}}{\par\vspace{0.7cm}}{}%
        \end{minipage}
    }
    \normalsize

    \vspace{-0.7cm}
    \textcolor{lightgray}{\noindent\rule{\textwidth}{0.5pt}}
    \end{center}
}

% Exam logo (top left of page 1). The compile writes the teacher's logo next to
% main.tex as examance-logo.<pdf|png|jpg|jpeg> (backend app/services/logo.py,
% frontend lib/latex/logo.ts); without one the header simply has no logo. The
% box is always 9mm tall, so the page layout (and the OMR template) is the
% same with and without a logo.
\newcommand{\ExamLogoFile}[1]{%
    \includegraphics[height=9mm,width=6cm,keepaspectratio]{#1}}
\newcommand{\ExamLogo}{%
    \IfFileExists{examance-logo.pdf}{\ExamLogoFile{examance-logo.pdf}}{%
    \IfFileExists{examance-logo.png}{\ExamLogoFile{examance-logo.png}}{%
    \IfFileExists{examance-logo.jpg}{\ExamLogoFile{examance-logo.jpg}}{%
    \IfFileExists{examance-logo.jpeg}{\ExamLogoFile{examance-logo.jpeg}}{%
    \rule{0pt}{9mm}}}}}}

% The output routine typesets the header inside whatever group the page broke in, so a task's local
% settings (e.g. \arraystretch) used to stretch the header (issue #137). Every header cell resets them.
\newlength{\SA@headindent}
% Distance of the header cells from the head edge, so they keep 20mm from the paper edge either way.
\newlength{\SA@headgap}
% Page 1's header with the corner tab: logo, then the title with date, class and teacher in one line centred under it, in the room up to 62mm from the cut side (each scaled down only if it does not fit).
\newsavebox{\SA@logobox}
\newlength{\SA@titlewidth}
% Date, class and teacher as separate items, joined with a centred dot; empty ones are left out.
\newsavebox{\SA@itembox}
\newcommand{\SA@infoitem}[1]{\sbox{\SA@itembox}{#1}\ifdim\wd\SA@itembox>\z@\SA@infosep\usebox{\SA@itembox}\def\SA@infosep{\ \textperiodcentered\ }\fi}
% \Datum carries the duration in brackets ("02.11.2026 (45 min)", frontend formatDatumAndDauer); split here, so exam sources (and their OMR template hashes) stay as they are.
\def\SA@splitdatum#1(#2)#3\@nil{\SA@infoitem{#1\unskip}\SA@infoitem{#2}}
% Order: course, date, duration, teacher.
\newcommand{\SA@infoline}{{\def\SA@infosep{}\SA@infoitem{\Klassetext}\expandafter\SA@splitdatum\Datumtext()\@nil\SA@infoitem{\Lehrernachnametext}}}
\newcommand{\SA@firsthead}{%
    \sbox{\SA@logobox}{\ExamLogo}%
    \setlength{\SA@titlewidth}{\dimexpr\headwidth-\SA@headgap-\wd\SA@logobox-\SA@headindent-8mm\relax}%
    \makebox[\headwidth][l]{\hspace{\SA@headgap}\usebox{\SA@logobox}\hfill\begin{tabular}[b]{@{}c@{}}%
        \adjustbox{max width=\SA@titlewidth}{\Large \Nrtext. \Testarttesttext \ in \Fachtext}\\[-1pt]%
        \adjustbox{max width=\SA@titlewidth}{\small \SA@infoline}%
    \end{tabular}\hfill\hspace*{\SA@headindent}}%
}
\newcommand{\SA@headreset}{%
    \normalfont\normalsize\normalcolor
    \renewcommand{\arraystretch}{1}\setlength{\extrarowheight}{0pt}\setlength{\tabcolsep}{6pt}%
}

% Setup headers and footers at document start
\AtBeginDocument{
    % The head spans the text, which already reaches 5mm from the edges.
    \fancyheadoffset[L]{0mm}\fancyheadoffset[R]{0mm}%
    % The header mirrors on even pages: the title on the uncut side, "Seite X" on the cut side, both 20mm from the paper edge (below the zone). Page 1 (\SA@firsthead)
    % has the logo and the title over one info line, kept 62mm from the cut side (outside the zone and 8mm clear of the moved fiducial).
    % With page codes the title also clears the marker moved to 66mm and the code beside it (77-91mm; issue #220).
    \ifthenelse{\boolean{SA@seitencode}}{\setlength{\SA@headindent}{9.1cm}}{\setlength{\SA@headindent}{5.7cm}}\setlength{\SA@headgap}{1.5cm}%
    % The head rule spans the head minus 5mm per side: ends at the text edge would cross the zone's tip. \nointerlineskip keeps it where fancyhdr's plain \hrule sits.
    \renewcommand{\headrule}{\nointerlineskip\hbox to\headwidth{\hskip5mm\leaders\hrule height\headrulewidth\hfill\hskip5mm}\vskip-\headrulewidth}%
    % An extra sheet names no exam: "Zusatzblatt" in the middle, clear of the sticker spot and the page code.
    \ifthenelse{\boolean{SA@zusatzblatt}}{\lhead{}\rhead{}\chead{\SA@headreset\bfseries Zusatzblatt}}{%
    \lhead{\SA@headreset\ifnum\thepage=1
    % No space after \SA@firsthead: it fills the whole head width, and a trailing space would wrap the cell and push the header down.
    \SA@firsthead
    \else
    \ifthenelse{\isodd{\value{page}}}{\hspace{\SA@headgap}\Nrtext. \Testarttesttext \ in \Fachtext}{\hspace{\SA@headgap}Seite \thepage}%
    \fi}
    \rhead{\SA@headreset
    \ifnum\thepage=1\else
    \ifthenelse{\isodd{\value{page}}}{Seite \thepage}{\Nrtext. \Testarttesttext \ in \Fachtext}\hspace*{\SA@headgap}%
    \fi
    }
    \chead{}}%
    % The page number is in the header: the strip between the bottom markers holds the score table.
    \cfoot{}

    \ifthenelse
        {\isundefined{\LFarbe}}
        {\newcommand{\LFarbe}{blue}}
        {}
    \ifthenelse{\boolean{SA@zusatzblatt}}{}{\Namenszeile}
}

% ==============================================================================
% 6b. OMR Fiducial Markers (every page, absolute position via eso-pic)
% ==============================================================================
% Four corner markers let the client locate a homography from a photographed
% scan back to the compiled PDF's coordinate space (see frontend omrWorker.ts).
% Unlike \Namenszeile, these must appear on EVERY page, since MC questions can
% land on any page -- \AddToShipoutPictureBG (eso-pic) re-runs per shipout.
% Each marker also carries an invisible \href link (like the OMR bubbles in
% Loesung.sty) so the same pdfjs getAnnotations() pass extracts both in one go.
% Note: fiducials sit inside the header's own vertical band (headheight/top
% margin unchanged) -- only \fancyheadoffset (packages.sty headheight stays as
% original) nudges \lhead/\rhead content 3mm inward so it clears the corners
% horizontally. Footer table placement (packages.sty bottom + tabularx inset)
% is sized so it stays outside the 13mm corner fiducial zone (5mm inset + 8mm size).
\newlength{\OmrFiducialSize}
\setlength{\OmrFiducialSize}{8mm}
\newlength{\OmrFiducialInset}
\setlength{\OmrFiducialInset}{5mm}

% Solid black square with a white/black inset -- cheap to find as the largest
% dark blob in each page-corner quadrant via flood fill.
\newcommand{\OmrFiducialShape}{%
    \begin{tikzpicture}
        \fill[black] (0,0) rectangle (\OmrFiducialSize,\OmrFiducialSize);
        \fill[white] (0.2\OmrFiducialSize,0.2\OmrFiducialSize) rectangle (0.8\OmrFiducialSize,0.8\OmrFiducialSize);
        \fill[black] (0.35\OmrFiducialSize,0.35\OmrFiducialSize) rectangle (0.65\OmrFiducialSize,0.65\OmrFiducialSize);
    \end{tikzpicture}%
}

% #1 = corner index (0=bottom-left,1=bottom-right,2=top-right,3=top-left),
% #2/#3 = offset from the page's lower-left corner, as TeX lengths (not bare
% \put numbers -- \LenToUnit converts a length to the decimal \put expects
% under the current \unitlength; \AtPageLowerLeft anchors the origin so 0,0
% is the physical lower-left corner regardless of margins, matching the
% 0=BL,1=BR,2=TR,3=TL convention omrWorker.ts assumes).
\newcommand{\OmrFiducialAt}[3]{%
    \typeout{[OMR-TRACE] OmrFiducialAt corner=#1 x=#2 y=#3}%
    \AtPageLowerLeft{\put(\LenToUnit{#2},\LenToUnit{#3}){\OmrLink{\OmrFiducialSize}{\OmrFiducialSize}{omr://__fid__/#1}\OmrFiducialShape}}%
}

% Both top markers sit 12mm from the top: the one by the cut corner (right on odd pages, left on even ones) 46mm from its side (66mm with page codes, section 11),
% outside the zone; the other in its corner at the usual inset, 8mm from a booklet's fold (mirrored in frontend lib/qr/cutCorner.ts).
\newlength{\SA@fidTopX}
\newlength{\SA@fidTopY}
\setlength{\SA@fidTopX}{46mm}
\setlength{\SA@fidTopY}{12mm}
\newlength{\SA@fidTRX}
\newlength{\SA@fidTLX}
\newlength{\SA@fidBLX}
\newlength{\SA@fidBRX}
\AddToShipoutPictureBG{%
    \setlength{\SA@fidTRX}{\SA@fidTopX}\setlength{\SA@fidTLX}{\SA@fidTopX}%
    \ifodd\value{page}\setlength{\SA@fidTLX}{\SA@foldinset}\else\setlength{\SA@fidTRX}{\SA@foldinset}\fi
    % The tab (75 x 20 mm at the outer top corner) is tinted light grey, so an unpersonalised sheet shows what a cut would remove, with the
    % dashed cut line and two scissors on it, blades towards the side edge (mirrored in lib/qr/examCopies.ts, which redraws page 1's tab).
    \AtPageUpperLeft{\begin{tikzpicture}[overlay,x=1mm,y=1mm]%
        \ifodd\value{page}%
            \fill[black!7] (\paperwidth-75mm,0) -- (\paperwidth,0) -- (\paperwidth,-20mm) -- cycle;%
            \draw[black!50,line width=0.6pt,dash pattern=on 4pt off 3pt] (\paperwidth-75mm,0) -- (\paperwidth,-20mm);%
            \foreach \SA@t in {0.33,0.67} {\SA@scissors{({\paperwidth-75mm+\SA@t*75mm},{-\SA@t*20mm})}{-14.93}}%
        \else%
            \fill[black!7] (75mm,0) -- (0,0) -- (0,-20mm) -- cycle;%
            \draw[black!50,line width=0.6pt,dash pattern=on 4pt off 3pt] (75mm,0) -- (0,-20mm);%
            \foreach \SA@t in {0.33,0.67} {\SA@scissors{({75mm-\SA@t*75mm},{-\SA@t*20mm})}{194.93}}%
        \fi%
    \end{tikzpicture}}%
    % The bottom marker on the fold side keeps clear of a booklet's cut strip (\SA@foldinset equals the inset otherwise).
    \setlength{\SA@fidBLX}{\OmrFiducialInset}\setlength{\SA@fidBRX}{\OmrFiducialInset}%
    \ifodd\value{page}\setlength{\SA@fidBLX}{\SA@foldinset}\else\setlength{\SA@fidBRX}{\SA@foldinset}\fi
    \OmrFiducialAt{0}{\SA@fidBLX}{\OmrFiducialInset}%
    \OmrFiducialAt{1}{\dimexpr\paperwidth-\SA@fidBRX-\OmrFiducialSize\relax}{\OmrFiducialInset}%
    \OmrFiducialAt{2}{\dimexpr\paperwidth-\SA@fidTRX-\OmrFiducialSize\relax}{\dimexpr\paperheight-\SA@fidTopY-\OmrFiducialSize\relax}%
    \OmrFiducialAt{3}{\SA@fidTLX}{\dimexpr\paperheight-\SA@fidTopY-\OmrFiducialSize\relax}%
}

% ==============================================================================
% 7. Points Table Generation at Document End
% ==============================================================================

% The points table of width #1, from the rows \AtEndDocument collects.
\newcommand{\SA@scoretable}[1]{\begin{tabularx}{#1}{|*{\N}{C|}C|C|}\hline
    \the\cols & $\sum$ & Note\\\hline
    \the\scorecols & \formatScore{\TotalScoreG} & \OmrScoreCell{grade}\\\cline{1-\theNotenzeile}
    \the\last & \OmrScoreCell{sum} & \OmrScoreCell{grade}\\\hline
\end{tabularx}}

\AtEndDocument{%
    \vfill
    \ifthenelse{\boolean{Pkt}}{%
        \Large
        \noindent
        \N=\value{Punkte}%
        \setcounter{Notenzeile}{\value{Punkte}}%
        \stepcounter{Notenzeile}%
        \cols={}%
        \scorecols={}%
        \last={}%
        \setcounter{i}{1}%
        \loop
            \edef\tempcols{\the\cols \the\value{i}}%
            \cols=\expandafter{\tempcols}%
            \edef\tempscores{\the\scorecols \noexpand\getScore{\the\value{i}}}%
            \scorecols=\expandafter{\tempscores}%
            \edef\templast{\the\last \noexpand\OmrScoreCell{cell/\the\value{i}}}%
            \last=\expandafter{\templast}%
            \ifnum\value{i}<\N
                \cols=\expandafter{\the\cols &}%
                \scorecols=\expandafter{\the\scorecols &}%
                \last=\expandafter{\the\last&}%
                \stepcounter{i}%
        \repeat

        % The table fills the strip between the bottom markers (1.5mm clear of them, also with a booklet's fold-side marker at 8mm) and ends level with their bottom edge, 9mm below the body; zero declared depth keeps the page breaks unchanged.
        \@tempdima=\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep-\textheight-\OmrFiducialInset\relax
        \makebox[\textwidth]{\raisebox{\dimexpr\depth-\@tempdima\relax}[\dimexpr\height+\depth-\@tempdima\relax][0pt]{\SA@scoretable{\dimexpr\paperwidth-\OmrFiducialInset-\SA@foldinset-2\OmrFiducialSize-3mm\relax}}}%
        \normalsize
    }{}%
}

% ==============================================================================
% 8. Exercise Environment (Aufgabe) & Layout Settings
% ==============================================================================

\newlength{\FirstColWidth}
\setlength{\FirstColWidth}{2mm}
\newlength{\LastColWidth}
\setlength{\LastColWidth}{15mm}
\newlength{\MiddleColWidth}
\setlength{\MiddleColWidth}{\dimexpr\textwidth - \FirstColWidth - \LastColWidth - 5mm}
\newsavebox{\TaskBox}

% Page-break blocks: a task is cut at the end of each Teilaufgabe (block 1 = title, stem and a); block n = what
% follows the previous part through the next one) and at \Seitenumbruch. Each pass writes every block's height
% to the .aux; the next pass moves a block that fits on a page but not in the space left (\needspace).
\newif\ifSA@inblock
\newcount\SA@blockno
\newdimen\SA@h
\def\SA@blockid{\thePunkte-\the\SA@blockno}
\def\SA@bs#1#2#3{\expandafter\gdef\csname SA@bs@#1\endcsname{{#2}{#3}}}
\def\SA@be#1#2#3{\expandafter\gdef\csname SA@be@#1\endcsname{{#2}{#3}}}
% Deferred write: page and position are those of the shipped page.
\def\SA@savepos#1{%
    \pdfsavepos
    \edef\SA@tmp{\write\@auxout{\string\SA@#1{\SA@blockid}{\noexpand\the\c@page}{\noexpand\the\pdflastypos}}}%
    \SA@tmp
}
% \SA@h := height of block #1 from the previous pass (start page/y, end page/y in sp), -1sp if unknown.
\def\SA@height#1{%
    \SA@h=-1sp
    \ifcsname SA@bs@#1\endcsname\ifcsname SA@be@#1\endcsname
        \expandafter\expandafter\expandafter\SA@height@a\csname SA@bs@#1\endcsname{#1}%
    \fi\fi
}
\def\SA@height@a#1#2#3{\expandafter\expandafter\expandafter\SA@height@b\csname SA@be@#3\endcsname{#1}{#2}}
\def\SA@height@b#1#2#3#4{% end page, end y, start page, start y
    \ifnum#1=#3\relax
        \SA@h=\dimexpr#4sp-#2sp\relax
    \else
        \SA@h=\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax % top of the text area
        \SA@h=\dimexpr#4sp-(\SA@h-\textheight) + \textheight*(#1-#3-1) + \SA@h-#2sp\relax
    \fi
    \SA@h=\numexpr\SA@h/65536*65536\relax sp% whole pt, so passes settle
}
% #1 = space to keep in any case (the title's 3cm; a block taller than a page keeps only this).
\def\SA@blockbegin#1{%
    \par
    \global\advance\SA@blockno\@ne
    \SA@height{\SA@blockid}%
    \ifdim\SA@h<\textheight\else\SA@h=-1sp\fi
    \ifdim\SA@h<#1\SA@h=#1\fi
    \ifdim\SA@h>\z@ \needspace{\SA@h}\fi
    \global\SA@inblocktrue
    \SA@savepos{bs}%
}
\def\SA@blockend{\par\ifSA@inblock \SA@savepos{be}\global\SA@inblockfalse\fi}
% Teacher override: a page break exactly here; the blocks on both sides keep their rules.
\newcommand{\Seitenumbruch}{\par\ifSA@inblock\SA@blockend\newpage\SA@blockbegin\z@\else\newpage\fi}

% Rest-of-page writing area as the last item of the exam (issues #156, #228): #1 title, #2 note (may be empty), #3/#4 min/max height
% in cm, drawn in the exam's paper (\SA@pattern). Fills the space left on the page (minus the points table \AtEndDocument sets at the
% bottom) within min..max; when min does not fit it takes a whole new page instead (an implicit extra page). Student sheet only.
\newdimen\EN@avail
\newdimen\EN@title
\newdimen\EN@fill
% Heading and note share one line, each in its own size; a long note wraps under it.
\newcommand{\EN@head}[2]{%
    \noindent{\large\bfseries #1}\if\relax\detokenize{#2}\relax\else\quad{\small #2}\fi\par
}
\newcommand{\ExamNotes}[4]{%
    \ifthenelse{\boolean{Antworten}}{}{%
        \par
        \begingroup
        \normalfont\normalsize
        \setbox\z@\vbox{\hsize\textwidth\EN@head{#1}{#2}}%
        \EN@title=\dimexpr\ht\z@+\dp\z@+5mm\relax
        \ifdim\pagegoal=\maxdimen \EN@avail=\textheight \else \EN@avail=\dimexpr\pagegoal-\pagetotal\relax \fi
        % A sticker spot page loses 17mm to the spot (section 11); counting it here keeps the area on its page.
        \ifSA@spotpage\advance\EN@avail by -\SA@spotroom\fi
        \ifthenelse{\boolean{Pkt}}{\advance\EN@avail by -27mm}{}%
        \EN@fill=\dimexpr\EN@avail-\EN@title\relax
        \ifdim\EN@fill<#3cm
            \newpage
            \EN@fill=\dimexpr\textheight-\EN@title\relax
            \ifSA@spotpage\advance\EN@fill by -\SA@spotroom\fi
            \ifthenelse{\boolean{Pkt}}{\advance\EN@fill by -36mm}{}%
        \else
            \ifdim\EN@fill>#4cm \EN@fill=#4cm \fi
        \fi
        \ifdim\EN@fill<5mm \EN@fill=5mm \fi
        \vspace{3mm}%
        \EN@head{#1}{#2}\nobreak\vspace{2mm}%
        \noindent\SA@pattern{\linewidth}{\EN@fill}\par
        \endgroup
    }%
}

% A picture never ends a page: it stays with the text after it.
\def\SA@keepwithnext{\ifvmode\else\ifinner\else\vadjust{\penalty\@M}\fi\fi}
\AtBeginDocument{%
    \NewCommandCopy\SA@includegraphics\includegraphics
    \RenewDocumentCommand\includegraphics{s o o m}{%
        \IfBooleanTF{#1}%
            {\IfNoValueTF{#2}{\SA@includegraphics*{#4}}{\IfNoValueTF{#3}{\SA@includegraphics*[#2]{#4}}{\SA@includegraphics*[#2][#3]{#4}}}}%
            {\IfNoValueTF{#2}{\SA@includegraphics{#4}}{\IfNoValueTF{#3}{\SA@includegraphics[#2]{#4}}{\SA@includegraphics[#2][#3]{#4}}}}%
        \SA@keepwithnext
    }%
}

% The score box sits at the right end of the title line like the Teilaufgabe box; \hangindent keeps the title line
% clear of it. Never a wrapfigure: it left \linewidth 3cm short for the whole first paragraph (issue #140) and
% wrapped the title line differently per document (issue #138); nor a band above the title, which wasted a line.
% Page breaks follow the blocks above; without a measured height the title keeps 3cm of its task (issue #113).
\newenvironment{Aufgabe}[2][]
{%
\par
% Fixed size for \quad and \hangindent: they used to follow the \LARGE that \Namenszeile leaks into exams, so the
% exercise preview (no \Namenszeile) wrapped differently (issue #111).
\LARGE
\addvspace{\dimexpr 1ex + \topskip\relax}%
\stepcounter{Punkte}%
\global\SA@blockno\z@
\SA@blockbegin{3cm}%
% An invisible rule survives a page top, so the box stays 4pt below the header rule there (issue #106); the kern
% takes back the \topskip that TeX puts before the rule at a page top, and \addvspace the same amount mid-page.
\hrule\@height\z@\nobreak\kern\dimexpr 4pt - \topskip\relax
    \neverindent
    \gdef\TaskScore{0}% Reset task score accumulator for the new exercise
    \gdef\TaskFixedScore{}% \FestePunkte inside the body
    \def\ManualScore{#1}% Store optional override

    % Read from .aux to populate the score box
    \ifcsname AufgabeScore\thePunkte\endcsname
        \edef\Pkt{\csname AufgabeScore\thePunkte\endcsname}%
        \def\PrintPkt{\formatScore{\Pkt}}%
    \else
        \def\Pkt{0}% Fallback for internal arrays
        \def\PrintPkt{-}% UI Fallback for the very first compilation
    \fi
    % \aPunkte mapping removed (unused)
    % Title line with the score box (no \par between the shape and the title, or TeX resets the shape)
    % The blank carries an omr://__box__ link so grading can fill it in (issue #187).
    \sbox\TaskBox{\Large\framebox[1.1\width]{ \OmrScoreSlot{~~~~~}{omr://__box__/task/\thePunkte} / ~\PrintPkt~}}%
    \noindent
    \hangindent=-\dimexpr\wd\TaskBox+1em\relax \hangafter=-1
    % Bottom on the baseline: hanging below it, the box ran into the second line, which \hangindent does not shorten.
    \makebox[0pt][l]{\hspace{\linewidth}\llap{\raisebox{\dp\TaskBox}{\usebox\TaskBox}}}%
    \textbf{\Large (\thePunkte) #2} \quad
    \ignorespaces \normalsize
}
{%
    \SA@blockend
    \vspace{1ex}%
    % Determine final score: auto-calculated or manual override?
    \ifx\ManualScore\empty
        \ifx\TaskFixedScore\empty
            \xdef\FinalScore{\TaskScore}%
        \else
            \xdef\FinalScore{\TaskFixedScore}%
        \fi
    \else
        \xdef\FinalScore{\ManualScore}%
    \fi

    % Write the evaluated score to the .aux file for the next run
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space AufgabeScore\thePunkte\string\endcsname{\FinalScore}}%

    % Add current score to global exam total
    \xdef\TotalScoreG{\fpeval{\TotalScoreG + \FinalScore}}%
    \normalsize
}

% ==============================================================================
% 8b. Part Exercises (Teilaufgabe, issue #77)
% ==============================================================================
% \begin{Teilaufgabe}[fixed score]{subtitle} inside an Aufgabe: labelled a), b), ..., the title run in
% like \paragraph, with its own score box. Its BE count towards the Aufgabe as usual; a fixed score replaces them.
% Like the Aufgabe box, the part box reads its score from the .aux of the previous run.
\newcounter{Teilaufgabe}[Punkte]
\renewcommand{\theTeilaufgabe}{\alph{Teilaufgabe}}

\newsavebox{\PartBox}
\newenvironment{Teilaufgabe}[2][]
{%
    \par\vspace{1ex}\noindent
    \stepcounter{Teilaufgabe}%
    \@inTeilaufgabetrue
    \gdef\PartScore{0}%
    \gdef\PartFixedScore{#1}%
    \ifcsname TeilScore\thePunkte\theTeilaufgabe\endcsname
        \def\PrintPartPkt{\formatScore{\csname TeilScore\thePunkte\theTeilaufgabe\endcsname}}%
    \else
        \def\PrintPartPkt{-}%
    \fi
    % Run-in title like \paragraph. The score box hangs at the right end of the first line,
    % which \hangindent shortens so the text never runs into it.
    \sbox\PartBox{\large\framebox[1.1\width]{\OmrScoreSlot{~~~~}{omr://__box__/part/\thePunkte/\theTeilaufgabe} / ~\PrintPartPkt~}}%
    \hangindent=-\dimexpr\wd\PartBox+1em\relax \hangafter=-1
    \makebox[0pt][l]{\hspace{\linewidth}\llap{\usebox\PartBox}}%
    \textbf{\theTeilaufgabe)\if\relax\detokenize{#2}\relax\else~#2\fi}\quad
    \ignorespaces
}
{%
    \par
    \ifx\PartFixedScore\empty
        \xdef\FinalPartScore{\PartScore}%
    \else
        \xdef\FinalPartScore{\PartFixedScore}%
        \xdef\TaskScore{\fpeval{\TaskScore - \PartScore + \PartFixedScore}}%
    \fi
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space TeilScore\thePunkte\theTeilaufgabe\string\endcsname{\FinalPartScore}}%
    \SA@blockend\SA@blockbegin\z@
}

% ==============================================================================
% 9. Indentation Behavior
% ==============================================================================
\newlength{\pardefault}
\setlength{\pardefault}{\parindent}
\newcommand{\neverindent}{\setlength{\parindent}{0pt}}
\newcommand{\autoindent}{\setlength{\parindent}{\pardefault}}

\if@neverindent
    \neverindent
\fi

% ==============================================================================
% 10. Packages Loaded by Exercises
% ==============================================================================
% The compile loads the packages named by \usepackage lines of exercise bodies in the preamble (issue #108,
% lib/latex/packages.ts, app/services/latex_packages.py), so in the body they are no-ops. Skipped there:
% inputenc/fontenc (pdfLaTeX only) and enumerate (enumitem's shortlabels option replaces it).
\ifdefined\AddToHook % LaTeX 2020-10 or newer; older kernels keep the plain "preamble only" error
\ExplSyntaxOn
\NewDocumentCommand \SchulaufgabeBodyUsepackage { O{} m O{} }
  {
    \clist_map_inline:nn {#2}
      {
        \cs_if_exist:cF { ver@ ##1 .sty }
          {
            \clist_if_in:nnF { inputenc, fontenc, enumerate } {##1}
              {
                \PackageError {Schulaufgabe}
                  {
                    Package~`##1'~was~not~loaded:~write~its~\token_to_str:N \usepackage \c_space_tl
                    on~one~line~or~see~the~LaTeX~package~settings
                  }
                  { The~compile~loads~exercise~packages~in~the~preamble,~one~line~at~a~time,~unless~unsupported. }
              }
          }
      }
  }
\ExplSyntaxOff
\AddToHook{begindocument/end}{\let\usepackage\SchulaufgabeBodyUsepackage}
\fi

% ==============================================================================
% 11. Multi-sheet layout (issue #220, docs/dev/multi_sheet_exams.md)
% ==============================================================================
% Each option works on its own and none is set for exams compiled before, so they keep their layout and OMR template.
\ifthenelse{\boolean{SA@seitencode}}{\setlength{\SA@fidTopX}{66mm}}{}

% Page codes: the exam builder (frontend lib/exam/pageCodes.ts) defines one per page as \Seitencode{page}{grid}{runs}: a QR code of
% grid x grid modules (quiet zone included), drawn as dark runs x/y/w from the lower left; pages past the last definition get none.
\newcommand{\Seitencode}[3]{\expandafter\gdef\csname SA@pc@#1\endcsname{\SA@pcdraw{#2}{#3}}}
\newlength{\SA@pcsize}
\setlength{\SA@pcsize}{14mm}
\newlength{\SA@pcmod}
\newcommand{\SA@pcdraw}[2]{%
    \setlength{\SA@pcmod}{\dimexpr\SA@pcsize/#1\relax}%
    \begin{tikzpicture}[x=\SA@pcmod,y=\SA@pcmod]%
        \fill[white] (0,0) rectangle (#1,#1);%
        \foreach \x/\y/\w in {#2} {\fill[black] (\x,\y) rectangle ++(\w,1);}%
    \end{tikzpicture}%
}
% The code sits on the inner side of the cut-side top marker (66-74mm), 77-91mm from the cut side, its bottom edge level with the
% marker's (20mm from the top); there the cut zone is only 2.6mm deep, and the head band keeps its height. Its invisible link lets
% printed copies (lib/qr/examCopies.ts) stamp the student's code over it; the scan reads it (lib/exam/pageCodes.ts, lib/scan/ingest.ts).
\newcommand{\SA@pagecode}{%
    \@ifundefined{SA@pc@\the\value{page}}{}{%
        \ifodd\value{page}\@tempdima=\dimexpr\paperwidth-77mm-\SA@pcsize\relax\else\@tempdima=77mm\fi
        \AtPageLowerLeft{\put(\LenToUnit{\@tempdima},\LenToUnit{\dimexpr\paperheight-20mm\relax}){%
            \OmrLink{\SA@pcsize}{\SA@pcsize}{omr://__page__/\the\value{page}}\csname SA@pc@\the\value{page}\endcsname}}%
    }%
}

% Sticker spots (\Aufkleberseiten{bogen} on every sheet front from page 3, {a3} on each A3 booklet sheet's front right page 2s+1, i.e.
% page p with 2p+2 <= total pages; frontend stickerPagesOf). A 35mm sticker goes over the header on the uncut side, 10mm beside that side's
% marker (15-50mm from the edge, 18-53mm on booklets) and 3-38mm from the top, on a faint unlabelled spot; only a 17mm strip at the top of the body stays free. The kernel's column height shrinks for such a page and
% \@makecol puts the room back as space above the text, so page breaks know it. The total comes from the previous pass's .aux.
\newlength{\SA@spotroom}
\setlength{\SA@spotroom}{17mm}
\newif\ifSA@spotpage
\def\SA@total{999}
\def\SA@spotathree{a3}
\newcommand{\SA@checkspot}{%
    \global\SA@spotpagefalse
    \ifodd\value{page}\ifnum\value{page}>2
        \ifx\SA@spotmode\SA@spotathree
            \ifnum\numexpr2*\value{page}+2\relax>\SA@total\relax\else\global\SA@spotpagetrue\fi
        \else\global\SA@spotpagetrue\fi
    \fi\fi
    \ifSA@spotpage\global\advance\@colht-\SA@spotroom\fi
}
\newcommand{\Aufkleberseiten}[1]{%
    \gdef\SA@spotmode{#1}%
    \apptocmd{\@outputpage}{\SA@checkspot}{}{\PackageWarning{Schulaufgabe}{Could not reserve room for sticker spots}}%
    \pretocmd{\@makecol}{\ifSA@spotpage\global\advance\@colht\SA@spotroom\fi}{}{}%
    \def\@texttop{\ifSA@spotpage\vskip\SA@spotroom\fi}%
    % After the filler pages; the \clearpage ships the last page first, so the counter is one past the total.
    \AtEndDocument{\clearpage\if@filesw\immediate\write\@auxout{\gdef\string\SA@total{\the\numexpr\value{page}-1\relax}}\fi}%
}
\newcommand{\SA@stickerspot}{%
    \ifodd\value{page}\@tempdima=\dimexpr\SA@foldinset+10mm\relax\else\@tempdima=\dimexpr\paperwidth-\SA@foldinset-45mm\relax\fi
    \AtPageLowerLeft{\put(\LenToUnit{\@tempdima},\LenToUnit{\dimexpr\paperheight-38mm\relax}){%
        \begin{tikzpicture}%
            \fill[black!4,rounded corners=1mm] (0,0) rectangle (35mm,35mm);%
        \end{tikzpicture}}}%
}

% Small scissors centred at #1, blades pointing along the angle #2 (degrees); the same shape as lib/qr/examCopies.ts.
\newcommand{\SA@scissors}[2]{%
    \begin{scope}[shift={#1},rotate=#2,x=0.3mm,y=0.3mm,black!50]%
        \draw[line width=0.5pt] (-3.2,-2) circle (1.5) (-3.2,2) circle (1.5);%
        \fill (-2,-1.6) -- (5.2,1.5) -- (-1.4,-0.6) -- cycle (-2,1.6) -- (5.2,-1.5) -- (-1.4,0.6) -- cycle;%
    \end{scope}%
}

% Booklets: a cut line 6mm from the fold edge (left on odd pages, right on even ones) with six scissors spread over its height, and the
% strip beyond it tinted like the corner tab, so a cut along the fold has 6mm either side and nobody writes there; text and fold-side
% markers start at 8mm (\SA@foldinset, lib/qr/cutCorner.ts FOLD_STRIP). The outer scissors sit 8mm from the paper edges (unprintable margin).
\newcommand{\SA@foldzone}{%
    \AtPageLowerLeft{\begin{tikzpicture}[overlay,x=1mm,y=1mm]%
        \ifodd\value{page}\def\SA@fx{0}\def\SA@lx{6}\else\def\SA@fx{\paperwidth}\def\SA@lx{\paperwidth-6mm}\fi
        \fill[black!7] (\SA@fx,0) rectangle (\SA@lx,\paperheight);%
        \pgfmathsetmacro\SA@fstep{(\paperheight-16mm)/5}%
        % Dashes between the scissors' gaps (3mm either side of each), then the scissors, blades pointing down along the line.
        \draw[black!50,line width=0.6pt,dash pattern=on 4pt off 3pt] (\SA@lx,0) -- (\SA@lx,5mm);%
        \foreach \SA@i in {0,...,4} {%
            \draw[black!50,line width=0.6pt,dash pattern=on 4pt off 3pt] (\SA@lx,{8mm+\SA@i*\SA@fstep+3mm}) -- (\SA@lx,{8mm+(\SA@i+1)*\SA@fstep-3mm});%
        }%
        \draw[black!50,line width=0.6pt,dash pattern=on 4pt off 3pt] (\SA@lx,\paperheight-5mm) -- (\SA@lx,\paperheight);%
        \foreach \SA@i in {0,...,5} {\SA@scissors{(\SA@lx,{8mm+\SA@i*\SA@fstep})}{-90}}%
    \end{tikzpicture}}%
}

\AddToShipoutPictureBG{%
    \ifthenelse{\boolean{SA@broschuere}}{\SA@foldzone}{}%
    % Page codes and sticker spots only on the student sheet.
    \ifthenelse{\boolean{Antworten}}{}{%
        \ifthenelse{\boolean{SA@seitencode}}{\SA@pagecode}{}%
        \ifSA@spotpage\SA@stickerspot\fi
        \ifthenelse{\boolean{SA@zusatzblatt}}{\ifnum\value{page}=1 \SA@stickerspot\fi}{}%
        \ifSA@wp\SA@wpdraw\global\SA@wpfalse\fi
    }%
}

% Writing paper (issue #228): \SA@pattern{width}{height} draws the exam's paper (\SA@paper) in whole 5mm squares or 8mm lines, light
% enough to write over; empty paper is blank space. The rest-of-page area (\ExamNotes) and full writing pages share it.
\newdimen\SA@wph
\def\SA@paperkaro{karo}
\def\SA@paperlinien{linien}
\def\SA@paperleer{leer}
\newcommand{\SA@pattern}[2]{%
    \SA@wph=#2\relax
    \ifx\SA@paper\SA@paperkaro
        \begin{tikzpicture}%
            \pgfmathtruncatemacro\SA@nx{#1/5mm}\pgfmathtruncatemacro\SA@ny{max(1,\the\SA@wph/5mm)}%
            \draw[black!30,line width=0.3pt,step=5mm] (0,0) grid (\SA@nx*5mm,\SA@ny*5mm);%
        \end{tikzpicture}%
    \else\ifx\SA@paper\SA@paperlinien
        \begin{tikzpicture}%
            \pgfmathtruncatemacro\SA@ny{max(1,\the\SA@wph/8mm)}%
            \path (0,0) rectangle (#1,\SA@ny*8mm);%
            \foreach \SA@li in {1,...,\SA@ny} {\draw[black!35,line width=0.4pt] (0,\SA@li*8mm) -- (#1,\SA@li*8mm);}%
        \end{tikzpicture}%
    \else\rule{\z@}{\SA@wph}\fi\fi
}

% A full writing page: heading #1 and note #2 (either may be empty) in the flow, the pattern at shipout over the text area below them.
% Drawn in the background, never in the flow, so it cannot spill onto a new page (a sticker spot page has 17mm less room than the
% page builder reports). Empty paper draws nothing, so workspace filler pages of older exams stay exactly as they were.
\newif\ifSA@wp
\newdimen\SA@wphead
\newcommand{\SA@wphd}[2]{%
    \if\relax\detokenize{#1#2}\relax\else\EN@head{#1}{#2}\fi
}
\newcommand{\SA@writingpage}[2]{%
    \null
    \setbox\z@\vbox{\hsize\textwidth\SA@wphd{#1}{#2}}%
    \global\SA@wphead=\dimexpr\ht\z@+\dp\z@\relax
    \SA@wphd{#1}{#2}%
    \global\SA@wptrue
    \clearpage
}
% The text area of this page: its top (from the page's lower left) and its left edge; booklets (twoside) mirror the margins.
\newdimen\SA@wptop
\newdimen\SA@wpleft
\newdimen\SA@wpoff
\newcommand{\SA@wpdraw}{%
    \ifx\SA@paper\SA@paperleer\else
        \SA@wptop=\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax
        \SA@wpleft=\dimexpr1in+\hoffset+\oddsidemargin\relax
        \if@twoside\ifodd\value{page}\else\SA@wpleft=\dimexpr1in+\hoffset+\evensidemargin\relax\fi\fi
        % Below the heading (with room for its first line's skip), and below a sticker spot on this page.
        \ifdim\SA@wphead>\z@ \SA@wpoff=\dimexpr\SA@wphead+\topskip+3mm\relax \else \SA@wpoff=\z@ \fi
        \ifSA@spotpage\advance\SA@wpoff by \SA@spotroom\fi
        \ifthenelse{\boolean{SA@zusatzblatt}}{\ifnum\value{page}=1 \advance\SA@wpoff by \SA@spotroom\fi}{}%
        \setbox\tw@\hbox{\SA@pattern{\textwidth}{\dimexpr\textheight-\SA@wpoff\relax}}%
        % Hangs from the top: the pattern's top edge sits right below the heading, whatever whole number of rows fits.
        \AtPageLowerLeft{\put(\LenToUnit{\SA@wpleft},\LenToUnit{\dimexpr\SA@wptop-\SA@wpoff-\ht\tw@\relax}){\box\tw@}}%
    \fi
}

% Extra pages in every copy (\Zusatzseiten{n}{title}{note}, issue #228): writing pages with the rest-of-page area's heading, after the
% points table and before the filler pages. They carry markers, page codes and sticker spots like any page, so they are part of the
% OMR template and personalised copies need nothing extra.
\def\SA@extracount{0}
% Without \Zusatzseiten the pages that fill whole sheets still get a heading.
\def\SA@extrapage{\SA@writingpage{Platz für weitere Lösungen}{}}
\newcommand{\Zusatzseiten}[3]{\gdef\SA@extracount{#1}\gdef\SA@extrapage{\SA@writingpage{#2}{#3}}}
\newcount\SA@extrai
\newcommand{\SA@extrapages}{%
    \ifnum\SA@extracount>\z@
        \clearpage
        \SA@extrai=\z@
        \loop\ifnum\SA@extrai<\SA@extracount
            \SA@extrapage
            \advance\SA@extrai by \@ne
        \repeat
    \fi
}
\AtEndDocument{\ifthenelse{\boolean{Antworten}}{}{\SA@extrapages}}

% The extra sheet (option zusatzblatt, issue #228): one sheet of writing paper, a sticker spot on the front (it names the student)
% and the code EXM1:X on both sides (frontend lib/exam/pageCodes.ts), so one printed stack serves every exam.
\newcommand{\Zusatzblatt}{%
    \SA@writingpage{}{}%
    \SA@writingpage{}{}%
}

% Filling up to whole sheets (2 pages, or 4 for a booklet): more extra pages after the asked ones. They carry markers (and page
% codes) like any page and are part of the OMR template, so a scanned one is an ordinary page (never dropped).
\newcount\SA@pages
\newif\ifSA@pad
\newcommand{\SA@fillsheets}{%
    \clearpage
    \SA@pages=\numexpr\value{page}-1\relax
    \ifthenelse{\boolean{SA@broschuere}}{\def\SA@persheet{4}}{\def\SA@persheet{2}}%
    \loop
        % Exact multiples are the only values the rounding division gives back unchanged.
        \ifnum\numexpr\SA@pages/\SA@persheet*\SA@persheet\relax=\SA@pages\relax\SA@padfalse\else\SA@padtrue\fi
    \ifSA@pad
        \SA@extrapage
        \advance\SA@pages by 1
    \repeat
}
\ifthenelse{\boolean{SA@fuellen}}{\AtEndDocument{\ifthenelse{\boolean{Antworten}}{}{\SA@fillsheets}}}{}

\endinput