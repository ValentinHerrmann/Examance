\newcommand*{\LoesungTitleExtensionText}{}
\newcommand{\LoesungTitleExtension}[1]{%
  \gdef\LoesungTitleExtensionText{%
    \color{\LFarbe}%
    \renewcommand{\umltextcolor}{blue}%
    \renewcommand{\umldrawcolor}{blue}%
    #1%
    \renewcommand{\umltextcolor}{black}%
    \renewcommand{\umldrawcolor}{black}%
    \color{black}%
  }%
}

\providecommand{\LSG}[2]{
	\ifthenelse
	{\boolean{Antworten}}
	{
        \textcolor{\LFarbe}{
            \renewcommand{\umltextcolor}{\LFarbe}
            \renewcommand{\umldrawcolor}{\LFarbe}
            #1
            \renewcommand{\umltextcolor}{black}
            \renewcommand{\umldrawcolor}{black}
        }
    }
	{
        \setbox0=\vbox{#1}%
        #2
    }
}

%Befehl für ein Leerfeld mit fester höhe
\newcommand{\Leer}[1]{\vspace{#1}}

\newcommand{\Loesung}[1]{
	\LSG{
		#1
	}{

	}
}

% Loesung, die normalen Text ersetzt
\newcommand{\LoesungReplace}[2]{%
	\LSG{
		#1
	}{
		#2
	}
}

%Loesung bzw. Leerfeld
\newcommand{\LoesungLeer}[2]{
	\LSG{
		#1
	}{
		\Leer{#2}
	}
}

% Verschiedene Bilder in Angabe und Loesung
\newcommand{\LoesungImg}[3]{
    \ifthenelse
	{\boolean{Antworten}}
	{\includegraphics[width=#3]{#1}}
	{\includegraphics[width=#3]{#2}}
}

%Loesung für Lückentext
\newcommand{\LoesungLuecke}[2]{
	\LSG{
		#1
	}{
		\noindent\rule{#2}{0.5pt}
	}
}

%Loesung bzw. Karo
\newcommand{\LoesungKaro}[2] {
	\LSG{
		#1
	}{
		\kariert{#2}
	}
}

%Loesung bzw. Linien
\newcommand{\LoesungLine}[2]{
	\LSG{
		#1
	}{
		\liniert{#2}
	}
}

\newcommand{\LoesungMulti}[2][2]{%
  \ifnum#1>1
    \begin{multicols}{#1}
      \begin{description}
        #2
      \end{description}
    \end{multicols}
  \else
    \begin{description}
      #2
    \end{description}
  \fi
}

\newcommand{\LoesungForm}[2]
{
   	\begin{Form} \color{\LFarbe}
		\TextField[bordercolor={},backgroundcolor={},width=#1, multiline=#2]{}\color{black}
	\end{Form}
}

\newcommand\kariert[2][0.5cm]{% 
	\begin{tikzpicture}[gray,step=#1]
	\pgfmathtruncatemacro\anzahl{(\linewidth-\pgflinewidth)/#1} % maximale Anzahl Kästchen pro Zeile
	\draw (0,0) rectangle (\anzahl*#1,#2*#1) (0,0) grid (\anzahl*#1,#2*#1);
	\end{tikzpicture} 
}

% --- OMR: MC option bubbles ------------------------------------------------
% \OmrExercise{<exerciseId>} is injected by the assembly layer (frontend
% scoreParser.ts / backend latex.py) immediately before each MC exercise's
% latexBody. It does not change \multi/\Lmulti's call signature -- stored
% latexBody strings keep working untouched. Each bubble gets an invisible
% \href{omr://<exerciseId>/<optionIndex>}{...} link so the client can read
% back exact rects via pdfjs page.getAnnotations() from a blank compile.
\newcommand*{\CurrentOmrId}{unassigned}
\newcounter{OmrOptCount}
\newcommand{\OmrExercise}[1]{%
	\gdef\CurrentOmrId{#1}%
	\setcounter{OmrOptCount}{0}%
	\typeout{[OMR-TRACE] OmrExercise id=#1}%
}

% Direct xdvipdfmx link annotation primitive for non-text graphics (TikZ)
\newcommand{\OmrLink}[3]{%
  \edef\w{\the\dimexpr#1\relax}%
  \edef\h{\the\dimexpr#2\relax}%
  \special{pdf:ann width \w\space height \h\space depth 0pt << /Subtype /Link /A << /S /URI /URI (#3) >> >>}%
}

\newlength{\OmrBoxSize}
\setlength{\OmrBoxSize}{4.5mm}
\newlength{\OmrRedoZoneWidth}
\setlength{\OmrRedoZoneWidth}{4mm}
% #1 (optional) = tikz drawing commands for the mark inside the box, e.g. an X
\newcommand{\OmrBox}[1][]{%
	\typeout{[OMR-TRACE] OmrBox id=\CurrentOmrId opt=\theOmrOptCount}%
	% Zero net width: the redo-zone link protrudes into the label's existing left margin
	% instead of pushing the box itself right -- the box's own position must stay pixel-exact
	% to before this feature existed, or already-printed/scanned exam sheets misalign against
	% a freshly-recaptured OMR template.
	\makebox[0pt][r]{\OmrLink{\OmrRedoZoneWidth}{\OmrBoxSize}{omr://\CurrentOmrId/\theOmrOptCount/redo}}%
	\OmrLink{\OmrBoxSize}{\OmrBoxSize}{omr://\CurrentOmrId/\theOmrOptCount}%
	\tikz[baseline=-0.5ex]{%
		\draw[black,line width=0.4pt] (0,0) rectangle (\OmrBoxSize,\OmrBoxSize);%
		#1%
	}%
}

\newcommand{\multi}{%
	\typeout{[OMR-TRACE] multi id=\CurrentOmrId opt=\theOmrOptCount}%
	\item[{\OmrBox}\hspace{2mm}]\stepcounter{OmrOptCount}%
}
\newcommand{\Lmulti}{%
	\typeout{[OMR-TRACE] Lmulti id=\CurrentOmrId opt=\theOmrOptCount}%
	\ifcsname TaskScore\endcsname\else\gdef\TaskScore{0}\fi%
	\ifthenelse
	{\boolean{Antworten}}
	{\xdef\TaskScore{\fpeval{\TaskScore + 1}}%
	 \item[{{\OmrBox[\node at (0.5\OmrBoxSize,0.5\OmrBoxSize) {\textcolor{\LFarbe}{X}};]}}\hspace{2mm}]
	 \stepcounter{OmrOptCount}}
	{\xdef\TaskScore{\fpeval{\TaskScore + 1}}%
	 \item[{\OmrBox}\hspace{2mm}]%
	 \stepcounter{OmrOptCount}}
 }

\newcommand\liniert[2][1.2cm]{% 
	\begin{tikzpicture}[gray]
	\path[use as bounding box](0,0)rectangle(\linewidth,-#2*#1-0.5\pgflinewidth); 
	\foreach \n in {1,...,#2}\draw(0 ,-#1*\n )--(\linewidth,-#1*\n ); 
	\end{tikzpicture}}

\endinput
