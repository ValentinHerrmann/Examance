\ProvidesPackage{sty/Loesung}[2026/06/23 Solutions macro definitions]

\lstset{
tabsize = 1, %% set tab space width
keywordstyle = \color{purple}, %% set keyword color
stringstyle = \color{green}, %% set string color
rulecolor = \color{black}, %% set frame color to avoid being affected by text color
breaklines = true, %% enable line breaking
numberstyle = \footnotesize,
language = Java , 
firstnumber = last , 
escapeinside={(*@}{@*)}
}
\newcommand*{\LoesungTitleExtensionText}{}
\newcommand{\LoesungTitleExtension}[1]{%
  \gdef\LoesungTitleExtensionText{%
    \color{\LFarbe}%
    \renewcommand{\umltextcolor}{blue}%
    \renewcommand{\umldrawcolor}{blue}%
    #1%
    \renewcommand{\umltextcolor}{black}%
    \renewcommand{\umldrawcolor}{black}%
    \color{black}%
  }%
}

% Student version: the solution is typeset into a discarded box, so a \BE/\hBE/\qBE inside
% it still adds to \TaskScore and the score box matches the solution sheet.
\newsavebox{\LSG@discard}
\providecommand{\LSG}[2]{%
	\ifthenelse{\boolean{Antworten}}{%
        \textcolor{\LFarbe}{%
            \renewcommand{\umltextcolor}{\LFarbe}%
            \renewcommand{\umldrawcolor}{\LFarbe}%
            #1%
            \renewcommand{\umltextcolor}{black}%
            \renewcommand{\umldrawcolor}{black}%
        }%
    }{%
        \savebox{\LSG@discard}{\parbox{\linewidth}{#1}}%
        #2%
    }%
}

%Befehl für ein Leerfeld mit fester höhe
\newcommand{\Leer}[1]{\vspace{#1}}

% Ends the paragraph before a solution field. A line just ended by \\ or \newline (\nobreak\hfil\break, older
% kernels add \null) loses that ending first, or \par would add an empty line; \\[len] keeps its space.
\def\LSG@trimskips{\ifnum\lastnodetype=11 \unskip\expandafter\LSG@trimskips\fi}
\def\LSG@endpar{%
	\ifvmode\else\ifinner\else
		\LSG@trimskips
		\setbox\z@\box\voidb@x
		\ifnum\lastnodetype=1 \setbox\z@\lastbox
			\ifdim\wd\z@=\z@\ifdim\ht\z@=\z@\ifdim\dp\z@=\z@ \setbox\z@\box\voidb@x \fi\fi\fi
		\fi
		\ifnum\lastpenalty=-\@M \ifvoid\z@ \unpenalty\LSG@trimskips\unpenalty \fi\fi
		\ifvoid\z@\else\box\z@\fi
		\par
	\fi\fi
}
% A solution field is its own paragraph tied to the line before it, so it never starts a page (issue #139).
\newcommand{\LSG@field}[1]{\LSG@endpar\nobreak\noindent#1\par}

\newcommand{\Loesung}[1]{
	\LSG{
		#1
	}{

	}
}

% Code solutions (issue #163): an environment, so lstlisting and unbalanced braces work (an argument cannot hold them).
% Student version typesets into the discarded box like \LSG instead of `comment`, so a (*@\BE@*) inside still counts.
\newenvironment{LoesungCode}{%
	\ifthenelse{\boolean{Antworten}}{%
		\def\LSG@codeend{}%
		\color{\LFarbe}%
		\renewcommand{\umltextcolor}{\LFarbe}%
		\renewcommand{\umldrawcolor}{\LFarbe}%
	}{%
		\def\LSG@codeend{\end{minipage}\end{lrbox}}%
		\begin{lrbox}{\LSG@discard}\begin{minipage}{\linewidth}%
	}%
}{\LSG@codeend}

% Loesung, die normalen Text ersetzt
\newcommand{\LoesungReplace}[2]{%
	\LSG{
		#1
	}{
		#2
	}
}

%Loesung bzw. Leerfeld
\newcommand{\LoesungLeer}[2]{
	\LSG{
		#1
	}{
		\ifvmode\nobreak\fi\Leer{#2}
	}
}

% Verschiedene Bilder in Angabe und Loesung
\newcommand{\LoesungImg}[3]{
    \ifthenelse
	{\boolean{Antworten}}
	{\includegraphics[width=#3]{#1}}
	{\includegraphics[width=#3]{#2}}
}

%Loesung für Lückentext
\newcommand{\LoesungLuecke}[2]{
	\LSG{
		#1
	}{
		\noindent\rule{#2}{0.5pt}
	}
}

%Loesung bzw. Karo
\newcommand{\LoesungKaro}[2] {
	\LSG{
		#1
	}{
		\LSG@field{\kariert{#2}}
	}
}

%Loesung bzw. Linien
\newcommand{\LoesungLine}[2]{
	\LSG{
		#1
	}{
		\LSG@field{\liniert{#2}}
	}
}

\newcommand{\LoesungMulti}[2][2]{%
  \ifnum#1>1
    \begin{multicols}{#1}
      \begin{description}
        #2
      \end{description}
    \end{multicols}
  \else
    \begin{description}
      #2
    \end{description}
  \fi
}

\newcommand{\LoesungForm}[2]
{
   	\begin{Form} \color{\LFarbe}
		\TextField[bordercolor={},backgroundcolor={},width=#1, multiline=#2]{}\color{black}
	\end{Form}
}

\newcommand\kariert[2][0.5cm]{% 
	\begin{tikzpicture}[gray,step=#1]
	\pgfmathtruncatemacro\anzahl{(\linewidth-\pgflinewidth)/#1} % maximale Anzahl Kästchen pro Zeile
	\draw (0,0) rectangle (\anzahl*#1,#2*#1) (0,0) grid (\anzahl*#1,#2*#1);
	\end{tikzpicture} 
}

% --- OMR: MC option bubbles ------------------------------------------------
% \OmrExercise{<exerciseId>} is injected by the assembly layer (frontend
% scoreParser.ts / backend latex.py) immediately before each MC exercise's
% latexBody. It does not change \multi/\Lmulti's call signature -- stored
% latexBody strings keep working untouched. Each bubble gets an invisible
% \href{omr://<exerciseId>/<optionIndex>}{...} link so the client can read
% back exact rects via pdfjs page.getAnnotations() from a blank compile.
\newcommand*{\CurrentOmrId}{unassigned}
\newcounter{OmrOptCount}
\newcommand{\OmrExercise}[1]{%
	\gdef\CurrentOmrId{#1}%
	\setcounter{OmrOptCount}{0}%
	\typeout{[OMR-TRACE] OmrExercise id=#1}%
}

% Direct xdvipdfmx link annotation primitive for non-text graphics (TikZ)
\newcommand{\OmrLink}[3]{%
  \edef\w{\the\dimexpr#1\relax}%
  \edef\h{\the\dimexpr#2\relax}%
  \special{pdf:ann width \w\space height \h\space depth 0pt << /Subtype /Link /A << /S /URI /URI (#3) >> >>}%
}

% Borderless link with an explicit depth, for the score boxes; \OmrLink stays byte-identical for bubbles and fiducials.
\newcommand{\OmrLinkBox}[4]{%
  \edef\OmrLinkW{\the\dimexpr#1\relax}%
  \edef\OmrLinkH{\the\dimexpr#2\relax}%
  \edef\OmrLinkD{\the\dimexpr#3\relax}%
  \special{pdf:ann width \OmrLinkW\space height \OmrLinkH\space depth \OmrLinkD\space << /Subtype /Link /Border [0 0 0] /A << /S /URI /URI (#4) >> >>}%
}
% Score box blank (issue #187): the link covers #1, whose width is unchanged, so line and page breaks never move.
\newsavebox{\OmrSlotBox}
\newcommand{\OmrScoreSlot}[2]{%
  \sbox\OmrSlotBox{#1}%
  \OmrLinkBox{\wd\OmrSlotBox}{\ht\strutbox}{\dp\strutbox}{#2}%
  \usebox\OmrSlotBox
}
% A score table cell of the full column width; #1 is the box key after omr://__box__/.
\newcommand{\OmrScoreCell}[1]{\makebox[\linewidth][l]{\OmrLinkBox{\linewidth}{\ht\strutbox}{\dp\strutbox}{omr://__box__/#1}}}

\newlength{\OmrBoxSize}
\setlength{\OmrBoxSize}{4.5mm}
\newlength{\OmrRedoZoneWidth}
\setlength{\OmrRedoZoneWidth}{4mm}
% #1 (optional) = tikz drawing commands for the mark inside the box, e.g. an X
\newcommand{\OmrBox}[1][]{%
	\typeout{[OMR-TRACE] OmrBox id=\CurrentOmrId opt=\theOmrOptCount}%
	% Zero net width: the redo-zone link protrudes into the label's existing left margin
	% instead of pushing the box itself right -- the box's own position must stay pixel-exact
	% to before this feature existed, or already-printed/scanned exam sheets misalign against
	% a freshly-recaptured OMR template.
	\makebox[0pt][r]{\OmrLink{\OmrRedoZoneWidth}{\OmrBoxSize}{omr://\CurrentOmrId/\theOmrOptCount/redo}}%
	\OmrLink{\OmrBoxSize}{\OmrBoxSize}{omr://\CurrentOmrId/\theOmrOptCount}%
	\tikz[baseline=-0.5ex]{%
		\draw[black,line width=0.4pt] (0,0) rectangle (\OmrBoxSize,\OmrBoxSize);%
		#1%
	}%
}

% Correction legend for MC tasks (issue #192): plain TikZ, never \OmrBox/\OmrLink, so it never becomes an OMR bubble.
\newcommand{\McHinweisKreuz}{\draw[line width=0.6pt] (0.15,0.15) -- (0.85,0.85) (0.15,0.85) -- (0.85,0.15);}
\newcommand{\McHinweisBox}[1]{\tikz[baseline=-0.5ex,x=2.8mm,y=2.8mm]{\draw[line width=0.4pt,#1] (0,0) rectangle (1,1);}}
\newcommand{\McHinweisKreuzBox}{\tikz[baseline=-0.5ex,x=2.8mm,y=2.8mm]{\draw[line width=0.4pt] (0,0) rectangle (1,1); \McHinweisKreuz}}
\newcommand{\McHinweisLinksKreuz}{\tikz[baseline=-0.5ex,x=2.8mm,y=2.8mm]{\begin{scope}[shift={(-1.2,0)}]\McHinweisKreuz\end{scope}\draw[line width=0.4pt,fill=black] (0,0) rectangle (1,1);}}
\newcommand{\McKorrekturHinweis}{%
	\par\smallskip\noindent{\footnotesize Ankreuzen: \McHinweisKreuzBox
	\quad Zurücknehmen: Kästchen ausmalen \McHinweisBox{fill=black}
	\quad Erneut wählen: links daneben ankreuzen \McHinweisLinksKreuz}\par\smallskip%
}

\newcommand{\multi}{%
	\typeout{[OMR-TRACE] multi id=\CurrentOmrId opt=\theOmrOptCount}%
	\item[{\OmrBox}\hspace{2mm}]\stepcounter{OmrOptCount}%
}
\newcommand{\Lmulti}{%
	\typeout{[OMR-TRACE] Lmulti id=\CurrentOmrId opt=\theOmrOptCount}%
	\ifcsname TaskScore\endcsname\else\gdef\TaskScore{0}\fi%
	\ifthenelse
	{\boolean{Antworten}}
	{\xdef\TaskScore{\fpeval{\TaskScore + 1}}%
	 \item[{{\OmrBox[\node at (0.5\OmrBoxSize,0.5\OmrBoxSize) {\textcolor{\LFarbe}{X}};]}}\hspace{2mm}]
	 \stepcounter{OmrOptCount}}
	{\xdef\TaskScore{\fpeval{\TaskScore + 1}}%
	 \item[{\OmrBox}\hspace{2mm}]%
	 \stepcounter{OmrOptCount}}
 }

\newcommand\liniert[2][1.2cm]{% 
	\begin{tikzpicture}[gray]
	\path[use as bounding box](0,0)rectangle(\linewidth,-#2*#1-0.5\pgflinewidth); 
	\foreach \n in {1,...,#2}\draw(0 ,-#1*\n )--(\linewidth,-#1*\n ); 
	\end{tikzpicture}}

\endinput
