# BlindGrade backend local development environment
# Copy this file to backend/.env and adjust values for your machine.

# Postgres (recommended for local dev)
DATABASE_URL=postgresql+asyncpg://blindgrade:blindgrade@localhost:5432/blindgrade
DATABASE_URL_SYNC=postgresql+psycopg2://blindgrade:blindgrade@localhost:5432/blindgrade

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
# Replace with a strong random value in production.
SECRET_KEY=dev-secret-key-change-me-in-production-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# CORS (JSON array or comma-separated list)
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "https://examance.pages.dev"]
CORS_ALLOWED_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*valentin-herrmann\.com|https://([a-zA-Z0-9-]+\.)?examance\.pages\.dev

# Runtime mode
ENVIRONMENT=development





# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP Configuration (optional in dev — logs reset links if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend URL (used for password reset email links)
FRONTEND_URL=

# Password Reset Token TTL (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=24

# Optional: SQLite fallback for quick local experiments only.
# DATABASE_URL=sqlite+aiosqlite:///./blindgrade.db
# DATABASE_URL_SYNC=sqlite:///./blindgrade.db
