# BlindGrade backend local development environment
# Copy this file to backend/.env and adjust values for your machine.

# Postgres (recommended for local dev)
DATABASE_URL=postgresql+asyncpg://blindgrade:blindgrade@localhost:5432/blindgrade
DATABASE_URL_SYNC=postgresql+psycopg2://blindgrade:blindgrade@localhost:5432/blindgrade

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
# Replace with a strong random value in production.
SECRET_KEY=dev-secret-key-change-me-in-production-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Per-account login cooloff (app/services/login_throttle.py). Complements the
# IP-keyed slowapi limits, which do nothing against a guesser rotating source
# addresses. Defaults to whatever RATE_LIMIT_ENABLED is set to.
#
# The cooloff is capped on purpose: any per-account lockout lets someone who
# knows an email address lock its owner out, so it always expires by itself.
# LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_FAIL_WINDOW_SECONDS=900

# CORS (JSON array or comma-separated list)
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "https://examance.pages.dev"]
CORS_ALLOWED_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*valentin-herrmann\.com|https://([a-zA-Z0-9-]+\.)?examance\.pages\.dev

# Runtime mode & logging
ENVIRONMENT=development
LOG_LEVEL=INFO


# Initial Admin Bootstrap
# Notes for production / preview deployments:
# 1. Quote string values if they contain special characters (e.g. #). Unquoted # will be treated as comment start in docker compose .env files.
# 2. Bootstrap is idempotent by existence: it only creates the admin if no matching user exists. If an account already exists, changing these vars will not overwrite it; use `python -m app.cli set-password --email <email>` instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP Configuration (optional in dev — logs reset links if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend URL (used for password reset email links)
FRONTEND_URL=

# Password Reset Token TTL (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=24

# Optional: SQLite fallback for quick local experiments only.
# DATABASE_URL=sqlite+aiosqlite:///./blindgrade.db
# DATABASE_URL_SYNC=sqlite:///./blindgrade.db
