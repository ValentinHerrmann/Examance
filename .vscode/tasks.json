{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Alembic Migrate",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DATABASE_URL_SYNC": "postgresql+psycopg2://blindgrade:blindgrade@localhost:5432/blindgrade",
          "ENVIRONMENT": "development",
          "SECRET_KEY": "dev-secret-key-change-me-in-production-32-chars-long!"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Wait 1s",
      "type": "shell",
      "command": "sleep 1",
      "problemMatcher": []
    },
    {
      "label": "Frontend Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^__never_matches__$"
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http://localhost:5173"
        }
      }
    },
    {
      "label": "Open App in Browser",
      "type": "shell",
      "command": "xdg-open http://localhost:5173",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Full Stack",
      "dependsOrder": "sequence",
      "dependsOn": ["Alembic Migrate", "Frontend Dev Server", "Open App in Browser"],
      "problemMatcher": []
    },
    {
      "label": "Stop Frontend Dev Server",
      "command": "${input:terminateFrontendDevServer}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateFrontendDevServer",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Frontend Dev Server"
    }
  ]
}
