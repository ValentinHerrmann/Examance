// Cloudflare Workers static assets for the docs site (issue #174): `release` deploys production, every other branch uploads a preview version.
{
  "name": "examance-docs",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": ".vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
