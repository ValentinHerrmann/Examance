# Cloudflare Pages response headers.
#
# The backend sets its own CSP, but that only covers API responses. This origin
# is the one that renders the app, holds session key material, and decrypts
# student PII in memory — it needs its own headers.
#
# 'wasm-unsafe-eval' is required by argon2-browser, zxing-wasm and busytex.
# blob: covers the compiler worker and pdf.js rendering.
# camera=(self) keeps QR scanning working; every other permission is denied.
#
# connect-src must list the backend origins users actually configure. Update it
# together with CORS_ALLOWED_ORIGINS in the backend.
#
# script-src also carries the hash of SvelteKit's inline hydration bootstrap
# script (the one adapter-static injects into every prerendered index.html
# to kick off `import("/_app/immutable/entry/start...")`). That script's
# content — and therefore its hash — is only stable across builds because
# svelte.config.js pins `kit.version.name` to a constant instead of the
# default Date.now(). If you ever change that inline bootstrap (SvelteKit
# upgrade, custom app.html script, etc.), regenerate the hash with:
#   node -e "const c=require('crypto'),h=require('fs').readFileSync('build/index.html','utf8').match(/<script>([\s\S]*?)<\/script>/)[1];console.log('sha256-'+c.createHash('sha256').update(h,'utf8').digest('base64'))"
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-04YzmV0NyxDPRxtqiAn9tOLVtNjwvDYTqm7ZbDoS0mA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.valentin-herrmann.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/core/busytex/*.wasm
  Content-Type: application/wasm

/core/busytex/*.wasm.bin
  Content-Type: application/wasm

/wasm/*.wasm
  Content-Type: application/wasm
