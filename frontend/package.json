{
  "name": "blindgrade-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "predev": "node scripts/fetch-busytex.mjs static/core && node scripts/process-large-files.mjs static && cp -r ../backend/latex-assets static/ && node scripts/generate-latex-assets-index.js",
    "dev": "vite dev",
    "prebuild": "cp -r ../backend/latex-assets static/ && node scripts/generate-latex-assets-index.js",
    "build": "node scripts/build.mjs && npm run process-large-files && npm run csp:headers && npm run csp:verify",
    "process-large-files": "node scripts/process-large-files.mjs build",
    "csp:headers": "node scripts/generate-csp-headers.mjs build",
    "csp:verify": "node scripts/verify-csp-headers.mjs build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "sri:verify": "node scripts/verify-sri.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@embedpdf/snippet": "^2.15.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "argon2-browser": "^1.18.0",
    "codemirror": "^6.0.2",
    "dexie": "^4.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.3",
    "texlyre-busytex": "^1.2.3",
    "zxing-wasm": "^1.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.44.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.0",
    "eslint": "^9.5.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.3.0",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  }
}
