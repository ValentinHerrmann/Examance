# Frontend build variables. Copy to frontend/.env (git-ignored) and adjust; variables set in the build environment (e.g. Cloudflare Pages) win over this file.

# Documentation site linked in the footer and from every in-app help section (ending with "/").
PUBLIC_DOCS_URL=https://docs.examance.de/

# API address (docs/hosting.md §5.1). Empty: https://api.<the frontend's host>. Set it to avoid a
# second subdomain level (e.g. https://preview-api.example.org for preview.example.org). It must be
# on the frontend's site (same registrable domain): the session cookies are SameSite=Strict.
# Setting it also lets the build put the exact origin into the CSP's connect-src.
PUBLIC_API_URL=

# Domain move (docs/hosting.md, "Moving to a new domain"): old frontend host, new origin, and the day
# the old host starts forwarding. Pages builds of release/preview default to the maintainer's move;
# an empty FROM switches it off.
# PUBLIC_DOMAIN_MOVE_FROM=old.example.com
# PUBLIC_DOMAIN_MOVE_FROM_API_URL=https://api.old.example.com
# PUBLIC_DOMAIN_MOVE_TO=https://new.example.com
# PUBLIC_DOMAIN_MOVE_REDIRECT_DATE=2026-11-23

# Operator details on the legal notice and privacy policy (docs/hosting.md, section 5.1). Never commit real values.
VITE_LEGAL_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_POSTCODE_CITY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
