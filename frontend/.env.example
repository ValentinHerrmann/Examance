# Frontend build variables. Copy to frontend/.env (git-ignored) and adjust; variables set in the build environment (e.g. Cloudflare Pages) win over this file.

# Documentation site linked in the footer and from every in-app help section (ending with "/").
PUBLIC_DOCS_URL=https://docs.examance.de/

# API address a new browser starts with (teachers can change it). Empty: production/preview default by branch on Cloudflare Pages, same origin locally.
PUBLIC_DEFAULT_BACKEND_URL=
# Defaults behind the branch rule above.
# PUBLIC_PROD_BACKEND_URL=https://api.examance.de
# PUBLIC_PREVIEW_BACKEND_URL=https://preview-api.examance.de
# Domain move (docs/domain_move.md): old frontend host, its API, the new origin and the deadline.
# Pages builds of release/preview default to the maintainer's move; an empty FROM switches it off.
# PUBLIC_DOMAIN_MOVE_FROM=old.example.com
# PUBLIC_DOMAIN_MOVE_FROM_BACKEND_URL=https://api.old.example.com
# PUBLIC_DOMAIN_MOVE_TO=https://new.example.com
# PUBLIC_DOMAIN_MOVE_DEADLINE=2026-12-07

# Operator details on the legal notice and privacy policy (docs/hosting.md, section 5.1). Never commit real values.
VITE_LEGAL_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_POSTCODE_CITY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
