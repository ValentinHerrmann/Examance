# Production environment file for the Examance backend stack.
#
# Copy to the server as <DEPLOY_APP_DIR>/prod/.env and fill in real values.
# NEVER commit the filled-in copy — it holds the production signing key.
#
#   install -m 600 /dev/null ~/examance/prod/.env
#
# The deploy workflow writes BACKEND_IMAGE on every run; everything else here
# is set once by hand.

# Image tag, overwritten by .github/workflows/deploy-release.yml on each deploy.
BACKEND_IMAGE=ghcr.io/valentinherrmann/examance-backend:latest

# Loopback port Caddy proxies to. Must differ from the preview stack's.
APP_PORT=9002

# Generate once, then never rotate casually — rotating invalidates every
# outstanding access and refresh token:
#   openssl rand -hex 32
SECRET_KEY=

# Generate once:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=examance
POSTGRES_DB=examance

# JSON array or comma-separated. Must name the production frontend origins.
# There is no wildcard fallback; an empty value is a hard startup error.
CORS_ALLOWED_ORIGINS=["https://examance.pages.dev","https://examance.valentin-herrmann.com"]

# Host header allowlist (TrustedHostMiddleware). Must match all reverse-proxy host headers
# routed to this backend and include loopback origins (127.0.0.1, localhost) so container healthchecks pass.
ALLOWED_HOSTS=["api-examance.valentin-herrmann.com","127.0.0.1","localhost"]

ENVIRONMENT=production
LOG_LEVEL=INFO

# Docker bridge gateway that Caddy's proxied requests arrive from. Find it with:
#   docker network inspect examance-prod_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Never set this to "*".
PROXY_ALLOWED_IPS=172.23.0.1
NETWORK_SUBNET=172.23.0.0/16



# Initial Admin Bootstrap
# Notes:
# 1. Quote values containing special characters (especially #, which docker compose treats as comment start).
# 2. Bootstrap creates the initial admin ONLY if no user with INITIAL_ADMIN_EMAIL exists yet.
#    If the account exists with different credentials, bootstrap will log a warning and skip.
#    To change the password for an existing account, run:
#    docker compose -p examance-prod -f docker-compose.deploy.yml --env-file .env exec backend python -m app.cli set-password --email <email>
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP Configuration (optional in dev — logs reset links if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend URL (used for password reset email links)
FRONTEND_URL=https://examance.valentin-herrmann.com/

# Password Reset Token TTL (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=24

# Self-registration (issue #53, always available): verify the e-mail address through a mailed
# link, choose a password, then wait for admin approval unless the domain is on the admin's
# always-allowed list. The link needs working SMTP.
REGISTRATION_TOKEN_TTL_HOURS=24
REGISTRATION_RESEND_COOLDOWN_SECONDS=300
# Verified registrations nobody approved are erased after this many days.
PENDING_ACCOUNT_RETENTION_DAYS=90

# Storage partitions (docs/dev/storage_partitions.md). Default: scans stay in Postgres.
# To keep scans on a separate disk or an rclone mount (pCloud, ...): set the host dir, mount it,
# run `... run --rm backend python -m app.cli init-blob-store` once, then set the backend to fs and
# deploy (the migration moves existing scans). Each stack needs its own directory.
# Host path (empty = a named volume); container path is always /data/blobs.
BLOB_STORAGE_HOST_DIR=
# Set to /data/blobs to use the partition.
BLOB_STORAGE_DIR=
BLOB_STORAGE_BACKEND=db

# Nightly backups with restic (opt-in): COMPOSE_PROFILES=backup; snapshots at 00:00 in BACKUP_TZ.
# One repository prefix and one password per stack. Keep BACKUP_RESTIC_PASSWORD in a password
# manager: without it the backups cannot be decrypted. Generate: openssl rand -base64 32
COMPOSE_PROFILES=
BACKUP_RESTIC_REPOSITORY=s3:https://s3.eu-central-3.ionoscloud.com/<bucket>/examance-prod
BACKUP_RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=eu-central-3
# Retention (restic forget): daily snapshots for N days, the newest per week for N weeks and per
# month for N months. Erased data survives in backups until the last snapshot holding it expires.
BACKUP_KEEP_DAILY_DAYS=7
BACKUP_KEEP_WEEKLY_WEEKS=4
BACKUP_KEEP_MONTHLY_MONTHS=3
BACKUP_TZ=Europe/Berlin
# Maintenance backups (issue #130): a database dump before every update and, if chosen, before manual
# maintenance; kept in maintenance-backups/ next to this file (plus restic tag `maintenance` when the
# repository above is set, independent of COMPOSE_PROFILES). Number of dumps to keep:
BACKUP_KEEP_MAINTENANCE=10
