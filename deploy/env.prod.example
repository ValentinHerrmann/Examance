# Production environment file for the Examance backend stack.
#
# Copy to the server as <DEPLOY_APP_DIR>/prod/.env and fill in real values.
# NEVER commit the filled-in copy — it holds the production signing key.
#
#   install -m 600 /dev/null ~/examance/prod/.env
#
# The deploy workflow writes BACKEND_IMAGE on every run; everything else here
# is set once by hand.

# Image tag, overwritten by .github/workflows/deploy-release.yml on each deploy.
BACKEND_IMAGE=ghcr.io/valentinherrmann/examance-backend:latest

# Loopback port nginx proxies to. Must differ from the preview stack's.
APP_PORT=8000

# Generate once, then never rotate casually — rotating invalidates every
# outstanding access and refresh token:
#   openssl rand -hex 32
SECRET_KEY=

# Generate once:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=blindgrade
POSTGRES_DB=blindgrade

# JSON array or comma-separated. Must name the production frontend origins.
# There is no wildcard fallback; an empty value is a hard startup error.
CORS_ALLOWED_ORIGINS=["https://examance.pages.dev","https://examance.valentin-herrmann.com"]

# Host header allowlist. Leave empty to disable the check.
ALLOWED_HOSTS=["api.examance.valentin-herrmann.com"]

ENVIRONMENT=production

# Docker bridge gateway that nginx's proxied requests arrive from. Find it with:
#   docker network inspect examance-prod_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Never set this to "*".
PROXY_ALLOWED_IPS=172.18.0.1
