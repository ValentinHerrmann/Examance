# Preview environment file for the Examance backend stack.
#
# Copy to the server as <DEPLOY_APP_DIR>/preview/.env and fill in real values.
# NEVER commit the filled-in copy.
#
# This stack is fully separate from production: its own image tag, port,
# database volume and signing key. Use a DIFFERENT SECRET_KEY and a DIFFERENT
# POSTGRES_PASSWORD from production — sharing them would let a preview build
# mint tokens the production instance accepts.

# Overwritten by .github/workflows/deploy-preview.yml on each deploy.
BACKEND_IMAGE=ghcr.io/valentinherrmann/examance-backend:preview

# Loopback port Caddy proxies to. Must differ from the production stack's.
APP_PORT=9001

# openssl rand -hex 32   (must NOT match production)
SECRET_KEY=

# openssl rand -hex 24   (must NOT match production)
POSTGRES_PASSWORD=
POSTGRES_USER=examance
POSTGRES_DB=examance

# The preview frontend lives on the `preview` branch of Cloudflare Pages, which
# is already covered by CORS_ALLOWED_ORIGIN_REGEX — but the explicit list still
# has to be non-empty.
CORS_ALLOWED_ORIGINS=["https://prev-examance.valentin-herrmann.com"]

# Restates config.py's default CORS_ALLOWED_ORIGIN_REGEX (any subdomain of
# valentin-herrmann.com, plus examance.pages.dev and its single-level preview
# subdomains) and additionally allows any http(s)://localhost or 127.0.0.1
# origin on any port. That third alternative is normally only appended when
# ENVIRONMENT=development — setting it here explicitly lets a local frontend
# dev server talk to the preview API without relaxing anything else that
# ENVIRONMENT=development would (e.g. the placeholder-SECRET_KEY check).
# Preview-only: never copy this into a production .env.
CORS_ALLOWED_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*valentin-herrmann\.com|https://([a-zA-Z0-9-]+\.)?examance\.pages\.dev|https?://(localhost|127\.0\.0\.1)(:\d+)?

# Host header allowlist (TrustedHostMiddleware). Must match all reverse-proxy host headers
# routed to this backend and include loopback origins (127.0.0.1, localhost) so container healthchecks pass.
ALLOWED_HOSTS=["prev-api-examance.valentin-herrmann.com","127.0.0.1","localhost"]

# Kept at "production" on purpose. `development` relaxes CORS to arbitrary
# localhost ports and disables the placeholder-SECRET_KEY check, neither of
# which belongs on an internet-reachable host.
ENVIRONMENT=production
LOG_LEVEL=INFO


#   docker network inspect examance-preview_default -f '{{(index .IPAM.Config 0).Gateway}}'
PROXY_ALLOWED_IPS=172.22.0.1
NETWORK_SUBNET=172.22.0.0/16



# Initial Admin Bootstrap
# Notes:
# 1. Quote values containing special characters (especially #, which docker compose treats as comment start).
# 2. Bootstrap creates the initial admin ONLY if no user with INITIAL_ADMIN_EMAIL exists yet.
#    If the account exists with different credentials, bootstrap will log a warning and skip.
#    To change the password for an existing account, run:
#    docker compose -p examance-preview -f docker-compose.deploy.yml --env-file .env exec backend python -m app.cli set-password --email <email>
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP Configuration (optional in dev — logs reset links if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend URL (used for password reset email links)
# Must NOT be the *.pages.dev URL: that domain is on URL blocklists, so mail
# relays reject reset mails linking to it ("Refused by local policy ... (B-URL)").
# Requires the custom domain to be attached to the `preview` branch deployment
# in Cloudflare Pages → Custom domains. Already covered by the CORS regex above.
FRONTEND_URL=https://prev-examance.valentin-herrmann.com/

# Password Reset Token TTL (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=24

# Self-registration (issue #53, always available): verify the e-mail address through a mailed
# link, choose a password, then wait for admin approval unless the domain is on the admin's
# always-allowed list. The link needs working SMTP.
REGISTRATION_TOKEN_TTL_HOURS=24
REGISTRATION_RESEND_COOLDOWN_SECONDS=300
# Verified registrations nobody approved are erased after this many days.
PENDING_ACCOUNT_RETENTION_DAYS=90


# Storage partitions (docs/dev/storage_partitions.md). Default: scans stay in Postgres.
# To keep scans on a separate disk or an rclone mount (pCloud, ...): set the host dir, mount it,
# run `... run --rm backend python -m app.cli init-blob-store` once, then set the backend to fs and
# deploy (the migration moves existing scans). Each stack needs its own directory.
# Host path (empty = a named volume); container path is always /data/blobs.
BLOB_STORAGE_HOST_DIR=
# Set to /data/blobs to use the partition.
BLOB_STORAGE_DIR=
BLOB_STORAGE_BACKEND=db

# Daily backups with restic (opt-in): COMPOSE_PROFILES=backup starts the service on every deploy.
# One repository prefix and one password per stack. Keep BACKUP_RESTIC_PASSWORD in a password
# manager: without it the backups cannot be decrypted. Generate: openssl rand -base64 32
COMPOSE_PROFILES=
BACKUP_RESTIC_REPOSITORY=s3:https://s3.eu-central-3.ionoscloud.com/<bucket>/examance-preview
BACKUP_RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=eu-central-3
# Retention (restic forget): daily snapshots for N days, the newest per week for N weeks and per
# month for N months. Erased data survives in backups until the last snapshot holding it expires.
BACKUP_KEEP_DAILY_DAYS=7
BACKUP_KEEP_WEEKLY_WEEKS=4
BACKUP_KEEP_MONTHLY_MONTHS=3
