# Preview environment file for the Examance backend stack.
#
# Copy to the server as <DEPLOY_APP_DIR>/preview/.env and fill in real values.
# NEVER commit the filled-in copy.
#
# This stack is fully separate from production: its own image tag, port,
# database volume and signing key. Use a DIFFERENT SECRET_KEY and a DIFFERENT
# POSTGRES_PASSWORD from production — sharing them would let a preview build
# mint tokens the production instance accepts.

# Overwritten by .github/workflows/deploy-preview.yml on each deploy.
BACKEND_IMAGE=ghcr.io/valentinherrmann/examance-backend:preview

# Loopback port nginx proxies to. Must differ from the production stack's.
APP_PORT=8001

# openssl rand -hex 32   (must NOT match production)
SECRET_KEY=

# openssl rand -hex 24   (must NOT match production)
POSTGRES_PASSWORD=
POSTGRES_USER=examance
POSTGRES_DB=examance

# The preview frontend lives on the `preview` branch of Cloudflare Pages, which
# is already covered by CORS_ALLOWED_ORIGIN_REGEX — but the explicit list still
# has to be non-empty.
CORS_ALLOWED_ORIGINS=["https://preview.examance.pages.dev"]

# Restates config.py's default CORS_ALLOWED_ORIGIN_REGEX (any subdomain of
# valentin-herrmann.com, plus examance.pages.dev and its single-level preview
# subdomains) and additionally allows any http(s)://localhost or 127.0.0.1
# origin on any port. That third alternative is normally only appended when
# ENVIRONMENT=development — setting it here explicitly lets a local frontend
# dev server talk to the preview API without relaxing anything else that
# ENVIRONMENT=development would (e.g. the placeholder-SECRET_KEY check).
# Preview-only: never copy this into a production .env.
CORS_ALLOWED_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*valentin-herrmann\.com|https://([a-zA-Z0-9-]+\.)?examance\.pages\.dev|https?://(localhost|127\.0\.0\.1)(:\d+)?

# Host header allowlist (TrustedHostMiddleware). Must match all reverse-proxy host headers
# routed to this backend (including both hyphenated 'prev-api' and dotted 'prev.api' variants)
# and include loopback origins (127.0.0.1, localhost) so container healthchecks pass.
ALLOWED_HOSTS=["prev-api-examance.valentin-herrmann.com","prev.api.examance.valentin-herrmann.com","127.0.0.1","localhost"]

# Kept at "production" on purpose. `development` relaxes CORS to arbitrary
# localhost ports and disables the placeholder-SECRET_KEY check, neither of
# which belongs on an internet-reachable host.
ENVIRONMENT=production


#   docker network inspect examance-preview_default -f '{{(index .IPAM.Config 0).Gateway}}'
PROXY_ALLOWED_IPS=172.19.0.1



# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP Configuration (optional in dev — logs reset links if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend URL (used for password reset email links)
FRONTEND_URL=https://preview.examance.pages.dev/

# Password Reset Token TTL (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=24